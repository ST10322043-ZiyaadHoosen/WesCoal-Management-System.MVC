@{
    ViewData["Title"] = "Eskom Arnot";
    ViewData["RoleName"] = "Sales Manager";
    ViewData["RoleSubtitle"] = "Sales Portal";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="contract-detail">
    <button class="back-link" data-nav="contracts">← Contracts</button>

    <div class="page-heading">
        <div>
            <p class="eyebrow">CONTRACT CSA-2026-001</p>
            <h1>Eskom Arnot</h1>
            <p>Coal Supply Agreement · Thermal coal</p>
        </div>
        <span class="badge green">Active</span>
    </div>

    <div class="stat-grid">
        <article>
            <small>Total tonnage</small>
            <strong>5,000 t</strong>
        </article>
        <article>
            <small>Delivered</small>
            <strong>3,400 t</strong>
        </article>
        <article>
            <small>Remaining</small>
            <strong>1,600 t</strong>
        </article>
        <article>
            <small>Current price (2026)</small>
            <strong>R1,250/t</strong>
        </article>
    </div>

    <article class="panel">
        <div class="panel-title">
            <h2>Contract progress</h2>
            <a class="btn-outline" href="#">View contract document</a>
        </div>
        <div class="progress large">
            <i style="width:68%"></i>
        </div>
        <div class="split-label">
            <span>Start: 01 Jan 2026</span>
            <b>68% delivered</b>
            <span>End: 31 Dec 2028</span>
        </div>

        <hr>

        <!-- EDITABLE PER-YEAR PRICING -->
        <div class="panel-title">
            <h2>Price per year</h2>
            <button type="button" id="editPricesBtn" class="btn-outline" style="padding:.5rem .9rem;">Edit prices</button>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th style="width:120px;">Year</th>
                        <th>Price per ton</th>
                        <th style="width:140px;">Status</th>
                    </tr>
                </thead>
                <tbody id="yearPriceBody">
                    <tr data-year="2026">
                        <td><b>2026</b></td>
                        <td data-price><span class="price-view">R1,250.00</span></td>
                        <td><span class="badge green">Set</span></td>
                    </tr>
                    <tr data-year="2027">
                        <td><b>2027</b></td>
                        <td data-price><span class="price-view">R1,340.00</span></td>
                        <td><span class="badge green">Set</span></td>
                    </tr>
                    <tr data-year="2028">
                        <td><b>2028</b></td>
                        <td data-price><span class="price-view muted">Not yet agreed</span></td>
                        <td><span class="badge amber">Pending</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="priceActions" class="form-actions" style="display:none;">
            <button type="button" id="cancelPrices" class="btn-outline">Cancel</button>
            <button type="button" id="savePrices" class="btn-gold" data-toast="Yearly prices updated">Save prices</button>
        </div>
        <p class="field-note">
            A Coal Supply Agreement is priced per year. Future years can be left as “Not yet agreed”
            at signing and set later once the rate is confirmed. Collections are always invoiced at
            the price of the year in which the coal was collected.
        </p>

        <hr>

        <!-- MONTHLY ALLOCATION -->
        <div class="panel-title">
            <h2>Monthly allocation</h2>
            <small class="field-note">Expected vs actual pace. Never blocks collection — it only tracks pace.</small>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Month</th>
                        <th>Contracted</th>
                        <th>Actual</th>
                        <th>Variance</th>
                        <th>Cumulative</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>June 2026</td>
                        <td>417 t</td>
                        <td>480 t</td>
                        <td class="pos">+63 t</td>
                        <td class="pos">+63 t</td>
                    </tr>
                    <tr>
                        <td>July 2026</td>
                        <td>417 t</td>
                        <td>520 t</td>
                        <td class="pos">+103 t</td>
                        <td class="pos">+166 t</td>
                    </tr>
                    <tr>
                        <td>August 2026</td>
                        <td>417 t</td>
                        <td>340 t</td>
                        <td class="neg">-77 t</td>
                        <td class="pos">+89 t</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="field-note">
            Monthly targets are derived from total tonnage ÷ contract term. The customer can collect
            ahead or behind pace; the cumulative figure shows the year-to-date position against the contract total.
        </p>
    </article>
</section>

@section Scripts {
    <script>
        (function(){
            const btn     = document.getElementById('editPricesBtn');
            const actions = document.getElementById('priceActions');
            const cancel  = document.getElementById('cancelPrices');
            const save    = document.getElementById('savePrices');
            const cells   = document.querySelectorAll('#yearPriceBody [data-price]');

            function parseVal(text){
                const t = text.replace(/[R,\s]/g,'').trim();
                return isNaN(parseFloat(t)) ? '' : parseFloat(t);
            }

            function toEdit(){
                cells.forEach(td=>{
                    const cur = parseVal(td.querySelector('.price-view').textContent);
                    td.innerHTML = `<input type="number" step="0.01" min="0" placeholder="Not yet agreed"
                                           value="${cur === '' ? '' : cur}" style="max-width:170px;">`;
                });
                btn.style.display='none';
                actions.style.display='flex';
            }

            function toView(){
                cells.forEach(td=>{
                    const input = td.querySelector('input');
                    const raw = input ? input.value.trim() : '';
                    if (raw === ''){
                        td.innerHTML = `<span class="price-view muted">Not yet agreed</span>`;
                    } else {
                        const num = parseFloat(raw).toLocaleString('en-ZA',{minimumFractionDigits:2});
                        td.innerHTML = `<span class="price-view">R${num}</span>`;
                    }
                });
                btn.style.display='';
                actions.style.display='none';
            }

            btn.addEventListener('click', toEdit);
            cancel.addEventListener('click', toView);
            save.addEventListener('click', toView);
        })();
    </script>
}
@{
    ViewData["Title"] = "Create Purchase Order";
    ViewData["RoleName"] = "Sales Manager";
    ViewData["RoleSubtitle"] = "Sales Portal";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="order-create">
    <button class="back-link" data-nav="orders">← Purchase orders</button>
    <div class="page-heading">
        <div>
            <p class="eyebrow">NEW ORDER</p>
            <h1>Create Purchase Order</h1>
            <p>Log a collection against an active contract.</p>
        </div>
    </div>
    <form class="panel form-card" data-demo-form data-success="Purchase order submitted to Finance">
        <div class="form-grid">
            <label>
                Customer *
                <select>
                    <option>Eskom Arnot</option>
                    <option>Msobo Coal</option>
                    <option>Seriti Resources</option>
                </select>
            </label>
            <label>
                Contract *
                <select>
                    <option>CSA-2026-001 · 1,600 t remaining</option>
                    <option>SPOT-2026-005 · 800 t remaining</option>
                </select>
            </label>
            <label>
                Service type *
                <select id="orderServiceType">
                    <option value="sale">Coal Sale</option>
                    <option value="wash">Coal Washing</option>
                </select>
            </label>
            <label id="orderProductField">
                Product *
                <select>
                    <option>Thermal coal</option>
                    <option>Nuts</option>
                    <option>Peas</option>
                    <option>Duff</option>
                    <option>Sweepings</option>
                </select>
            </label>
            <label>
                Order tonnage *<input required type="number" value="500">
            </label>
            <label>
                Expected collection date<input type="date" value="2026-08-15">
            </label>
            <label>
                Customer reference<input value="PO-1042">
            </label>
        </div>

        <p class="field-note">
            The order draws down the contract. A customer may order and collect freely —
            the only limit is the contract's remaining balance (1,600 t). The order itself
            is not capped; collection is only blocked once the contract total is reached.
        </p>

        <div class="info-box">
            This order will be sent to Finance for SAP entry, which activates it for collection.
        </div>

        <div class="form-actions">
            <button type="button" class="btn-outline" data-nav="orders">Cancel</button>
            <button class="btn-gold">Submit order</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (function () {
            const service = document.getElementById('orderServiceType');
            const productField = document.getElementById('orderProductField');
            function update() {
                // Coal washing is priced per ton washed, not per coal grade — hide the product picker
                productField.style.display = service.value === 'wash' ? 'none' : '';
            }
            service.addEventListener('change', update);
            update();
        })();
    </script>
}
@{
    ViewData["Title"] = "Eskom Arnot";
    ViewData["RoleName"] = "Sales Manager";
    ViewData["RoleSubtitle"] = "Sales Portal";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="customer-detail">
    <button class="back-link" data-nav="customers">← Customers</button>

    <div class="page-heading">
        <div>
            <p class="eyebrow">CUSTOMER CUST-001</p>
            <h1>Eskom Arnot</h1>
            <p>Arnot Power Station · Mpumalanga</p>
        </div>
        <button class="btn-outline" data-toast="Customer details saved">Edit customer</button>
    </div>

    <div class="detail-grid">
        <article class="panel">
            <h2>Contact details</h2>
            <dl>
                <dt>Contact person</dt>
                <dd>Thabo Mokoena</dd>

                <dt>Email</dt>
                <dd>thabo.mokoena@eskom.co.za</dd>

                <dt>Phone</dt>
                <dd>+27 13 297 1000</dd>

                <dt>VAT number</dt>
                <dd>4230187456</dd>

                <dt>Account status</dt>
                <dd><span class="badge green">Active</span></dd>
            </dl>
        </article>

        <article class="panel wide">
            <div class="panel-title">
                <h2>Contracts</h2>
                <button data-nav="contract-create">+ New contract</button>
            </div>

            <div class="mini-table">
                <button data-nav="contract-detail">
                    <b>CSA-2026-001</b>
                    <span>Coal Supply Agreement · 5,000 t · R1,250/t (2026)</span>
                    <em class="badge green">Active</em>
                </button>
                <button data-nav="contract-detail">
                    <b>SPOT-2026-005</b>
                    <span>Spot sale · 800 t · R1,400/t</span>
                    <em class="badge green">Active</em>
                </button>
            </div>
        </article>
    </div>
</section>
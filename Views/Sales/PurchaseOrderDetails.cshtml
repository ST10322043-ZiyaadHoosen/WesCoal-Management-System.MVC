@{
    ViewData["Title"] = "Eskom Arnot";
    ViewData["RoleName"] = "Sales Manager";
    ViewData["RoleSubtitle"] = "Sales Portal";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="order-detail">
    <button class="back-link" data-nav="orders">← Purchase orders</button>
    <div class="page-heading">
        <div>
            <p class="eyebrow">PURCHASE ORDER PO-1042</p>
            <h1>Eskom Arnot</h1>
            <p>SAP 45001234 · Thermal coal</p>
        </div>
        <span class="badge blue">In progress</span>
    </div>
    <div class="stat-grid">
        <article>
            <small>Ordered</small>
            <strong>500 t</strong>
        </article>
        <article>
            <small>Delivered</small>
            <strong>340 t</strong>
        </article>
        <article>
            <small>Remaining</small>
            <strong>160 t</strong>
        </article>
        <article>
            <small>Progress</small>
            <strong>68%</strong>
        </article>
    </div>
    <article class="panel">
        <h2>Delivery progress</h2>
        <div class="progress large">
            <i style="width:68%">
            </i>
        </div>
        <p class="muted">The weighbridge updates this balance after each completed truck transaction.</p>

        <hr>

        <h2>Status timeline</h2>
        <div class="timeline">
            <span class="done">Logged</span>
            <span class="done">SAP entered (activated)</span>
            <span class="current">In progress</span>
            <span>Fulfilled</span>
        </div>

        <hr>

        <div class="panel-title">
            <h2>Weighbridge collections</h2>
            <small class="field-note">Each completed truck transaction that makes up this order.</small>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Slip</th>
                        <th>Date</th>
                        <th>Truck</th>
                        <th>Driver</th>
                        <th>Net</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>SLP-0891</td>
                        <td>07 Aug 2026</td>
                        <td>GP 12 TY LF</td>
                        <td>Solomon Dube</td>
                        <td>28.6 t</td>
                    </tr>
                    <tr>
                        <td>SLP-0890</td>
                        <td>07 Aug 2026</td>
                        <td>NW 44 XZ LP</td>
                        <td>Thabo Nkosi</td>
                        <td>29.3 t</td>
                    </tr>
                    <tr>
                        <td>SLP-0885</td>
                        <td>06 Aug 2026</td>
                        <td>GP 12 TY LF</td>
                        <td>Solomon Dube</td>
                        <td>28.7 t</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="field-note">The sum of these collections is the delivered tonnage this order is invoiced on.</p>
    </article>
</section>
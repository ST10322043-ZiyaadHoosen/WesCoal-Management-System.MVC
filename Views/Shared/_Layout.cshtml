@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var isPortal = controller is "Home" or "Sales" or "Customer" or "Finance" or "Logistics" or "Management" or "SiteManager";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wescoal</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/portal-extra.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WesCoalMVC.styles.css" asp-append-version="true" />
</head>
<body class="wescoal-body">
    @if (!isPortal)
    {
        <header class="public-header">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container-fluid">
                    <a class="navbar-brand wescoal-brand" asp-controller="Home" asp-action="Index">
                        <span class="brand-mark">W</span>
                        <span>Wescoal</span>
                    </a>
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                            aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="navbar-collapse collapse justify-content-end">
                        <ul class="navbar-nav align-items-lg-center gap-lg-2">
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Sales" asp-action="Index">Sales Portal</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Customer" asp-action="Index">Customer Portal</a>
                            </li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Finance" asp-action="Index">Finance</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Logistics" asp-action="Index">Logistics</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Management" asp-action="Index">Management</a></li>
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="container-fluid p-0">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    @if (!isPortal)
    {
        <footer class="public-footer">
            <div class="container-fluid px-4">
                &copy; 2026 Wescoal Mining (Pty) Ltd
            </div>
        </footer>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

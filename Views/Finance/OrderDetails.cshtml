@{
    ViewData["Title"] = "Msobo Coal";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="order-detail">
    <button class="back-link" data-nav="queue">← Orders queue</button>

    <div class="page-heading">
        <div>
            <p class="eyebrow">PURCHASE ORDER PO-1048</p>
            <h1>Msobo Coal</h1>
            <p>ADH-2026-014 · Duff · 300 t</p>
        </div>
        <span class="badge amber">Awaiting SAP</span>
    </div>

    <div class="stat-grid">
        <article>
            <small>Ordered</small>
            <strong>300 t</strong>
        </article>
        <article>
            <small>Delivered</small>
            <strong>0 t</strong>
        </article>
        <article>
            <small>Price / ton</small>
            <strong>R1,310</strong>
        </article>
        <article>
            <small>Order value</small>
            <strong class="highlight">R393,000</strong>
        </article>
    </div>

    <article class="panel">
        <h2>Status timeline</h2>
        <div class="timeline">
            <span class="done">Logged</span>
            <span class="current">Awaiting SAP</span>
            <span>SAP attached</span>
            <span>In progress</span>
            <span>Fulfilled</span>
        </div>

        <hr>

        <h2>Order summary</h2>
        <dl class="detail-grid">
            <div>
                <dt>Customer</dt>
                <dd>Msobo Coal</dd>
            </div>
            <div>
                <dt>Contract</dt>
                <dd>ADH-2026-014 (Ad-hoc)</dd>
            </div>
            <div>
                <dt>Service type</dt>
                <dd>Coal sale · Duff</dd>
            </div>
            <div>
                <dt>Logged by</dt>
                <dd>Sales Manager · 11 Aug 2026</dd>
            </div>
            <div>
                <dt>Expected date</dt>
                <dd>15 Aug 2026</dd>
            </div>
            <div>
                <dt>Price per ton</dt>
                <dd>R1,310.00</dd>
            </div>
        </dl>
    </article>

    <form class="panel form-card" data-demo-form data-success="SAP number saved and order activated">
        <h2>SAP activation</h2>

        <div class="info-box">
            This order was authorised externally before it was logged. Attaching the SAP number
            activates it for Logistics and the weighbridge — there is no separate approval step.
        </div>

        <div class="form-grid">
            <label>
                SAP order number *
                <input required placeholder="e.g. 45001235">
            </label>
            <label>
                Finance reference
                <input placeholder="Optional reference">
            </label>
        </div>

        <div class="alert-box" style="margin-top:1.2rem;">
            <strong>Customer on hold</strong>
            <span>Msobo Coal has an overdue invoice. Even once activated, collection stays blocked until the outstanding invoice is marked paid.</span>
        </div>

        <div class="form-actions">
            <button type="button" class="btn-outline" data-nav="queue">Cancel</button>
            <button class="btn-gold">Save &amp; activate</button>
        </div>
    </form>
</section>
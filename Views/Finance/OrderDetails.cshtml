@{
    ViewData["Title"] = "Msobo Coal";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="order-detail">
    <button class="back-link" data-nav="queue">← Orders queue</button>
    <div class="page-heading">
        <div>
            <p class="eyebrow">PURCHASE ORDER PO-1048</p>
            <h1>Msobo Coal</h1>
            <p>ADH-2026-014 · Duff · 300 t</p>
        </div>
        <span class="badge amber">Awaiting SAP</span>
    </div>
    <div class="detail-grid">
        <article class="panel">
            <h2>Order summary</h2>
            <dl>
                <dt>Price per ton</dt>
                <dd>R1,310.00</dd>
                <dt>Order value</dt>
                <dd>R393,000.00</dd>
                <dt>Created by</dt>
                <dd>Sales Manager</dd>
                <dt>Expected date</dt>
                <dd>15 Aug 2026</dd>
            </dl>
        </article>
        <form class="panel form-card" data-demo-form data-success="SAP number saved and order activated">
            <h2>SAP activation</h2>
            <div class="form-grid">
                <label>
                    SAP order number *<input required placeholder="e.g. 45001235">
                </label>
                <label>
                    Finance reference<input placeholder="Optional reference">
                </label>
            </div>
            <div class="info-box">Activating this order makes it available to the weighbridge operator.</div>
            <div class="form-actions">
                <button type="button" class="btn-outline" data-toast="Order rejected and returned to Sales">Reject</button>
                <button class="btn-gold">Approve and activate</button>
            </div>
        </form>
    </div>
</section>


@{
    ViewData["Title"] = "Finance Dashboard";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="dashboard">
    <div class="page-heading">
        <div>
            <p class="eyebrow">FINANCIAL OPERATIONS</p>
            <h1>Finance Dashboard</h1>
            <p>SAP activation, invoicing and payment tracking.</p>
        </div>
    </div>

    <div class="alert-box">
        <strong>Credit hold</strong>
        <span>Msobo Coal is on hold because of an overdue invoice. Marking it paid lifts the hold and lets collection resume.</span>
        <button class="btn-outline" data-nav="payments">Review payments</button>
    </div>

    <div class="stat-grid">
        <article>
            <small>Awaiting SAP</small>
            <strong class="highlight">2</strong>
            <span>Finance action required</span>
        </article>
        <article>
            <small>Orders in progress</small>
            <strong>4</strong>
            <span>Collecting on site</span>
        </article>
        <article>
            <small>Outstanding</small>
            <strong>R687,000</strong>
            <span>2 unpaid invoices</span>
        </article>
        <article>
            <small>Collected this month</small>
            <strong>R1.2m</strong>
            <span>Paid invoices</span>
        </article>
    </div>

    <div class="content-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Orders awaiting SAP</h2>
                <button data-nav="queue">View all</button>
            </div>
            <div class="mini-table">
                <button data-nav="order-detail">
                    <b>PO-1048</b>
                    <span>Msobo Coal · 300 t</span>
                    <em class="badge amber">Awaiting SAP</em>
                </button>
                <button data-nav="order-detail">
                    <b>PO-1051</b>
                    <span>Seriti Resources · 250 t</span>
                    <em class="badge amber">Awaiting SAP</em>
                </button>
            </div>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>Recent invoices</h2>
                <button data-nav="invoices">View all</button>
            </div>
            <div class="mini-table">
                <button data-nav="invoice-detail">
                    <b>INV-2026-084</b>
                    <span>Eskom Arnot · R425,000</span>
                    <em class="badge amber">Unpaid</em>
                </button>
                <button data-nav="invoice-detail">
                    <b>INV-2026-071</b>
                    <span>Eskom Arnot · R600,000</span>
                    <em class="badge green">Paid</em>
                </button>
                <button data-nav="invoice-detail">
                    <b>INV-2026-043</b>
                    <span>Msobo Coal · R262,000</span>
                    <em class="badge red">Overdue</em>
                </button>
            </div>
        </article>
    </div>

    <!-- Needs attention -->
    <article class="panel" style="margin-top:1.3rem;">
        <div class="panel-title">
            <h2>Needs attention</h2>
            <small class="field-note">Actions only Finance can take.</small>
        </div>
        <div class="mini-table">
            <div>
                <b>PO-1048 · PO-1051</b>
                <span>Awaiting SAP number — attach to activate for collection</span>
                <em class="badge amber">2 to action</em>
            </div>
            <div>
                <b>INV-2026-043</b>
                <span>Msobo Coal overdue — mark as paid to lift the credit hold</span>
                <em class="badge red">Overdue</em>
            </div>
            <div>
                <b>7th of month</b>
                <span>Monthly invoice run due — generate from delivered tonnage</span>
                <em class="badge blue">Upcoming</em>
            </div>
        </div>
    </article>
</section>
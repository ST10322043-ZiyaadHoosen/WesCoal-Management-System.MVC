@{
    ViewData["Title"] = "Purchase Orders";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="orders">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ORDER TRACKING</p>
            <h1>Purchase Orders</h1>
            <p>Monitor SAP attachment and delivery progress across all orders.</p>
        </div>
    </div>

    <!-- Overview strip -->
    <div class="stat-grid">
        <article>
            <small>Awaiting SAP</small>
            <strong class="highlight">2</strong>
            <span>Need activation</span>
        </article>
        <article>
            <small>In progress</small>
            <strong>1</strong>
            <span>Collecting on site</span>
        </article>
        <article>
            <small>Ready</small>
            <strong>1</strong>
            <span>Activated, awaiting trucks</span>
        </article>
        <article>
            <small>Total order value</small>
            <strong>R2.53m</strong>
            <span>Across open orders</span>
        </article>
    </div>

    <!-- Filter bar -->
    <article class="panel" style="padding:1rem 1.1rem;margin-bottom:1.3rem;">
        <div class="toolbar" style="margin-bottom:0;">
            <input type="search" placeholder="Search order, customer or SAP number…">
            <select>
                <option>All statuses</option>
                <option>Awaiting SAP</option>
                <option>Ready</option>
                <option>In progress</option>
                <option>Fulfilled</option>
            </select>
        </div>
    </article>

    <!-- Order cards -->
    <div class="contract-list">

        <a class="contract-card" onclick="location.href='@Url.Action("OrderDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>PO-1048</b>
                    <span class="badge amber">Awaiting SAP</span>
                </div>
                <span class="badge amber">Action required</span>
            </div>
            <div class="cc-customer">Msobo Coal · Duff · ADH-2026-014</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:0%"></i></div>
                <div class="cc-figures">
                    <span><b>0 t</b> delivered</span>
                    <span><b>300 t</b> ordered</span>
                    <span>value <b>R393,000</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>SAP number</small><b class="muted">Not attached</b></div>
                <div><small>Contract</small><b>ADH-2026-014</b></div>
                <div><small>Customer</small><b class="neg">On hold</b></div>
                <div><small>Action</small><b class="neg">Attach SAP</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("OrderDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>PO-1051</b>
                    <span class="badge amber">Awaiting SAP</span>
                </div>
                <span class="badge amber">Action required</span>
            </div>
            <div class="cc-customer">Seriti Resources · Nuts · SPOT-2026-010</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:0%"></i></div>
                <div class="cc-figures">
                    <span><b>0 t</b> delivered</span>
                    <span><b>250 t</b> ordered</span>
                    <span>value <b>R350,000</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>SAP number</small><b class="muted">Not attached</b></div>
                <div><small>Contract</small><b>SPOT-2026-010</b></div>
                <div><small>Customer</small><b class="pos">Good standing</b></div>
                <div><small>Action</small><b class="neg">Attach SAP</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("OrderDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>PO-1042</b>
                    <span class="badge red">SAP 45001234</span>
                </div>
                <span class="badge blue">In progress</span>
            </div>
            <div class="cc-customer">Eskom Arnot · Thermal coal · CSA-2026-001</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:68%"></i></div>
                <div class="cc-figures">
                    <span><b>340 t</b> delivered</span>
                    <span><b>160 t</b> remaining</span>
                    <span>value <b>R625,000</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>SAP number</small><b>45001234</b></div>
                <div><small>Contract</small><b>CSA-2026-001</b></div>
                <div><small>Collections</small><b>10 loads</b></div>
                <div><small>Status</small><b class="pos">On track</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("OrderDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>PO-1045</b>
                    <span class="badge red">SAP 45001229</span>
                </div>
                <span class="badge green">Ready</span>
            </div>
            <div class="cc-customer">Seriti Resources · Thermal coal · SPOT-2026-009</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:0%"></i></div>
                <div class="cc-figures">
                    <span><b>0 t</b> delivered</span>
                    <span><b>400 t</b> ordered</span>
                    <span>value <b>R560,000</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>SAP number</small><b>45001229</b></div>
                <div><small>Contract</small><b>SPOT-2026-009</b></div>
                <div><small>Collections</small><b>0 loads</b></div>
                <div><small>Status</small><b>Activated</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("OrderDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>PO-1039</b>
                    <span class="badge red">SAP 45001230</span>
                </div>
                <span class="badge green">Fulfilled</span>
            </div>
            <div class="cc-customer">Eskom Arnot · Thermal coal · CSA-2026-001</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:100%"></i></div>
                <div class="cc-figures">
                    <span><b>480 t</b> delivered</span>
                    <span><b>0 t</b> remaining</span>
                    <span>value <b>R600,000</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>SAP number</small><b>45001230</b></div>
                <div><small>Contract</small><b>CSA-2026-001</b></div>
                <div><small>Collections</small><b>14 loads</b></div>
                <div><small>Status</small><b class="pos">Complete</b></div>
            </div>
        </a>

    </div>

    <p class="field-note" style="margin-top:1.3rem;">
        Purchase orders are the authorised collections against customer contracts. Finance attaches
        the SAP number to activate collection. Invoices are billed from actual delivered tonnage,
        not the original order value.
    </p>
</section>
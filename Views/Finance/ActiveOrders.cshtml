            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>SAP</th>
                        <th>Ordered</th>
                        <th>Delivered</th>
                        <th>Remaining</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-nav="order-detail">
                        <td>
                            <b>PO-1042</b>
                        </td>
                        <td>Eskom Arnot</td>
                        <td>45001234</td>
                        <td>500 t</td>
                        <td>340 t</td>
                        <td>160 t</td>
                        <td>
                            <span class="badge blue">In progress</span>
                        </td>
                    </tr>
                    <tr>
                        <td>
                            <b>PO-1045</b>
                        </td>
                        <td>Seriti Resources</td>
                        <td>45001229</td>
                        <td>400 t</td>
                        <td>0 t</td>
                        <td>400 t</td>

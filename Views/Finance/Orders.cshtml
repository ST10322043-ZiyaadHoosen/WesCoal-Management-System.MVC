@{
    ViewData["Title"] = "Purchase Orders";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="orders">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ORDER TRACKING</p>
            <h1>Purchase Orders</h1>
            <p>Monitor SAP attachment and delivery progress across all orders.</p>
        </div>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search order, customer or SAP number…">
            <select>
                <option>All statuses</option>
                <option>Awaiting SAP</option>
                <option>Ready</option>
                <option>In progress</option>
                <option>Fulfilled</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Contract</th>
                        <th>SAP number</th>
                        <th>Ordered</th>
                        <th>Delivered</th>
                        <th>Remaining</th>
                        <th>Value</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-nav="order-detail">
                        <td>
                            <b>PO-1042</b>
                        </td>
                        <td>Eskom Arnot</td>
                        <td>CSA-2026-001</td>
                        <td>45001234</td>
                        <td>500 t</td>
                        <td>340 t</td>
                        <td>160 t</td>
                        <td>R625,000</td>
                        <td>
                            <span class="badge blue">In progress</span>
                        </td>
                    </tr>
                    <tr data-nav="order-detail">
                        <td>
                            <b>PO-1045</b>
                        </td>
                        <td>Seriti Resources</td>
                        <td>SPOT-2026-009</td>
                        <td>45001229</td>
                        <td>400 t</td>
                        <td>0 t</td>
                        <td>400 t</td>
                        <td>R560,000</td>
                        <td>
                            <span class="badge green">Ready</span>
                        </td>
                    </tr>
                    <tr data-nav="order-detail">
                        <td>
                            <b>PO-1048</b>
                        </td>
                        <td>Msobo Coal</td>
                        <td>ADH-2026-014</td>
                        <td>—</td>
                        <td>300 t</td>
                        <td>0 t</td>
                        <td>300 t</td>
                        <td>R393,000</td>
                        <td>
                            <span class="badge amber">Awaiting SAP</span>
                        </td>
                    </tr>
                    <tr data-nav="order-detail">
                        <td>
                            <b>PO-1051</b>
                        </td>
                        <td>Seriti Resources</td>
                        <td>SPOT-2026-010</td>
                        <td>—</td>
                        <td>250 t</td>
                        <td>0 t</td>
                        <td>250 t</td>
                        <td>R350,000</td>
                        <td>
                            <span class="badge amber">Awaiting SAP</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="field-note">
            Purchase orders are the authorised collections against customer contracts.
            Finance attaches the SAP number to activate collection.
        </p>
    </article>
</section>
@{
    ViewData["Title"] = "Payments";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="payments">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ACCOUNTS</p>
            <h1>Payments</h1>
            <p>Record settlement and manage credit holds.</p>
        </div>
    </div>

    <!-- Overview strip -->
    <div class="stat-grid">
        <article>
            <small>Outstanding</small>
            <strong class="highlight">R687,000</strong>
            <span>2 unpaid invoices</span>
        </article>
        <article>
            <small>Overdue</small>
            <strong>R262,000</strong>
            <span>1 past due</span>
        </article>
        <article>
            <small>Collected</small>
            <strong>R600,000</strong>
            <span>1 settled</span>
        </article>
        <article>
            <small>On hold</small>
            <strong>1</strong>
            <span>Msobo Coal</span>
        </article>
    </div>

    <!-- Credit hold -->
    <article class="panel" style="margin-bottom:1.3rem;">
        <div class="panel-title">
            <h2>Credit holds</h2>
            <small class="field-note">Collection is frozen for these customers until settled.</small>
        </div>
        <div class="mini-table">
            <div>
                <b>Msobo Coal</b>
                <span>INV-2026-043 · R262,000 · overdue since 07 Aug</span>
                <button class="btn-gold" style="padding:.5rem .9rem;" data-toast="Payment recorded — hold lifted">Mark paid &amp; lift hold</button>
            </div>
        </div>
        <p class="field-note">
            Marking the outstanding invoice paid lifts the hold automatically — Sales can log new
            orders and the weighbridge can release coal to this customer again.
        </p>
    </article>

    <!-- Filter bar -->
    <article class="panel" style="padding:1rem 1.1rem;margin-bottom:1.3rem;">
        <div class="toolbar" style="margin-bottom:0;">
            <input type="search" placeholder="Search customer or invoice…">
            <select>
                <option>All payment statuses</option>
                <option>Paid</option>
                <option>Unpaid</option>
                <option>Overdue</option>
            </select>
        </div>
    </article>

    <!-- Payment cards -->
    <div class="contract-list">

        <a class="contract-card" data-nav="invoice-detail">
            <div class="cc-head">
                <div class="cc-id">
                    <b>INV-2026-043</b>
                    <span class="badge red">Overdue</span>
                </div>
                <span class="badge red">On hold</span>
            </div>
            <div class="cc-customer">Msobo Coal · June 2026</div>
            <div class="cc-meta">
                <div><small>Actual tonnage</small><b>200 t</b></div>
                <div><small>Price / t</small><b>R1,310</b></div>
                <div><small>Amount</small><b>R262,000</b></div>
                <div><small>Due</small><b class="neg">07 Aug 2026</b></div>
            </div>
            <div class="cc-hold">
                <button class="btn-gold" style="padding:.5rem .9rem;" data-toast="Payment recorded — hold lifted">Mark paid &amp; lift hold</button>
                <small>Overdue — collection frozen until settled.</small>
            </div>
        </a>

        <a class="contract-card" data-nav="invoice-detail">
            <div class="cc-head">
                <div class="cc-id">
                    <b>INV-2026-084</b>
                    <span class="badge amber">Unpaid</span>
                </div>
                <span class="badge green">Active</span>
            </div>
            <div class="cc-customer">Eskom Arnot · July 2026</div>
            <div class="cc-meta">
                <div><small>Actual tonnage</small><b>340 t</b></div>
                <div><small>Price / t (2026)</small><b>R1,250</b></div>
                <div><small>Amount</small><b>R425,000</b></div>
                <div><small>Due</small><b>07 Sep 2026</b></div>
            </div>
            <div class="cc-hold">
                <button class="btn-outline" style="padding:.5rem .9rem;" data-toast="Invoice marked paid">Mark paid</button>
                <small>Not yet due — account in good standing.</small>
            </div>
        </a>

        <a class="contract-card" data-nav="invoice-detail">
            <div class="cc-head">
                <div class="cc-id">
                    <b>INV-2026-071</b>
                    <span class="badge green">Paid</span>
                </div>
                <span class="badge green">Active</span>
            </div>
            <div class="cc-customer">Eskom Arnot · June 2026</div>
            <div class="cc-meta">
                <div><small>Actual tonnage</small><b>480 t</b></div>
                <div><small>Price / t (2026)</small><b>R1,250</b></div>
                <div><small>Amount</small><b>R600,000</b></div>
                <div><small>Settled</small><b class="pos">Paid</b></div>
            </div>
        </a>

    </div>

    <p class="field-note" style="margin-top:1.3rem;">
        Invoices are generated monthly from the actual tonnage recorded at the weighbridge. The customer
        is billed for exactly what they collected, not the order or contract target. Monthly allocation
        variances are carried forward and affect only the next month's pace target.
    </p>
</section>
@{
    ViewData["Title"] = "Payments";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="payments">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ACCOUNTS</p>
            <h1>Payments</h1>
            <p>Paid, unpaid and on-hold customer accounts.</p>
        </div>
    </div>
    <div class="alert-box">
        <strong>On hold</strong>
        <span>Msobo Coal cannot place new orders until INV-2026-043 is paid.</span>
    </div>
    <article class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Invoice</th>
                        <th>Amount</th>
                        <th>Due date</th>
                        <th>Payment</th>
                        <th>Account</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-nav="invoice-detail">
                        <td>Msobo Coal</td>
                        <td>INV-2026-043</td>
                        <td>R393,000</td>
                        <td>07 Aug 2026</td>
                        <td>
                            <span class="badge amber">Overdue</span>
                        </td>
                        <td>
                            <span class="badge amber">On hold</span>
                        </td>
                    </tr>
                    <tr>
                        <td>Eskom Arnot</td>
                        <td>INV-2026-071</td>
                        <td>R625,000</td>
                        <td>07 Aug 2026</td>
                        <td>
                            <span class="badge green">Paid</span>
                        </td>
                        <td>
                            <span class="badge green">Active</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>
</section>


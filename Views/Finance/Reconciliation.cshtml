@{
    ViewData["Title"] = "Order Reconciliation";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="reconciliation">
    <div class="page-heading">
        <div>
            <p class="eyebrow">CONTROL</p>
            <h1>Order Reconciliation</h1>
            <p>Compare ordered and delivered tonnage.</p>
        </div>
    </div>
    <div class="stat-grid">
        <article>
            <small>Ordered</small>
            <strong>1,900 t</strong>
        </article>
        <article>
            <small>Delivered</small>
            <strong>1,340 t</strong>
        </article>
        <article>
            <small>Outstanding</small>
            <strong>560 t</strong>
        </article>
        <article>
            <small>Variance</small>
            <strong>0.0%</strong>
        </article>
    </div>
    <article class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Ordered</th>
                        <th>Delivered</th>
                        <th>Variance</th>
                        <th>Progress</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>PO-1042</td>
                        <td>Eskom Arnot</td>
                        <td>500 t</td>
                        <td>340 t</td>
                        <td>160 t remaining</td>
                        <td>68%</td>
                    </tr>
                    <tr>
                        <td>PO-1039</td>
                        <td>Eskom Arnot</td>
                        <td>500 t</td>
                        <td>500 t</td>
                        <td>Matched</td>
                        <td>100%</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>
</section>


@{
    ViewData["Title"] = "Order Reconciliation";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="reconciliation">
    <div class="page-heading">
        <div>
            <p class="eyebrow">CONTROL</p>
            <h1>Order Reconciliation</h1>
            <p>Compare ordered and delivered tonnage.</p>
        </div>
    </div>

    <div class="stat-grid">
        <article>
            <small>Ordered</small>
            <strong>1,000 t</strong>
        </article>
        <article>
            <small>Delivered</small>
            <strong>840 t</strong>
        </article>
        <article>
            <small>Outstanding</small>
            <strong>160 t</strong>
        </article>
        <article>
            <small>Delivered</small>
            <strong>84%</strong>
        </article>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search order or customer…">
            <select>
                <option>All orders</option>
                <option>In progress</option>
                <option>Fulfilled</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Ordered</th>
                        <th>Delivered</th>
                        <th>Remaining</th>
                        <th>Progress</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-nav="order-detail">
                        <td>PO-1042</td>
                        <td>Eskom Arnot</td>
                        <td>500 t</td>
                        <td>340 t</td>
                        <td>160 t</td>
                        <td>68%</td>
                    </tr>
                    <tr data-nav="order-detail">
                        <td>PO-1039</td>
                        <td>Eskom Arnot</td>
                        <td>500 t</td>
                        <td>500 t</td>
                        <td>0 t</td>
                        <td>100%</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="field-note">
            Reconciliation compares order tonnage against actual weighbridge deliveries.
            Invoicing is always based on delivered tonnage, never on ordered or remaining amounts.
        </p>
    </article>
</section>
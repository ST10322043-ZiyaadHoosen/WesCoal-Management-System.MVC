@{
    ViewData["Title"] = "Contracts";
    ViewData["RoleName"] = "Finance Officer";
    ViewData["RoleSubtitle"] = "Finance Portal";
    ViewData["Initials"] = "FO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="contracts">
    <div class="page-heading">
        <div>
            <p class="eyebrow">AGREEMENTS</p>
            <h1>Contracts</h1>
            <p>Contract balances, pricing and expiry for invoicing.</p>
        </div>
    </div>

    <!-- Overview strip -->
    <div class="stat-grid">
        <article>
            <small>Active contracts</small>
            <strong>4</strong>
            <span>Across 3 customers</span>
        </article>
        <article>
            <small>Total contracted</small>
            <strong>8,450 t</strong>
            <span>All agreements</span>
        </article>
        <article>
            <small>Remaining tonnage</small>
            <strong>3,410 t</strong>
            <span>Still to collect</span>
        </article>
        <article>
            <small>Contract value</small>
            <strong class="highlight">R10.9m</strong>
            <span>All agreements</span>
        </article>
    </div>

    <!-- Filter bar -->
    <article class="panel" style="padding:1rem 1.1rem;margin-bottom:1.3rem;">
        <div class="toolbar" style="margin-bottom:0;">
            <input type="search" placeholder="Search contract or customer…">
            <select>
                <option>All statuses</option>
                <option>Active</option>
                <option>Completed</option>
                <option>Expired</option>
                <option>Cancelled</option>
            </select>
            <select>
                <option>All types</option>
                <option>Coal Supply Agreement</option>
                <option>Ad-hoc</option>
                <option>Spot sale</option>
            </select>
        </div>
    </article>

    <!-- Contract cards -->
    <div class="contract-list">

        <a class="contract-card" onclick="location.href='@Url.Action("ContractDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>CSA-2026-001</b>
                    <span class="badge red">Coal Supply Agreement</span>
                </div>
                <span class="badge green">Active</span>
            </div>
            <div class="cc-customer">Eskom Arnot · Thermal coal</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:68%"></i></div>
                <div class="cc-figures">
                    <span><b>3,400 t</b> delivered</span>
                    <span><b>1,600 t</b> remaining</span>
                    <span>of <b>5,000 t</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>Price / t (2026)</small><b>R1,250</b></div>
                <div><small>Type</small><b>CSA</b></div>
                <div><small>Ends</small><b>31 Dec 2026</b></div>
                <div><small>Status</small><b class="pos">Active</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("ContractDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>ADH-2026-014</b>
                    <span class="badge red">Ad-hoc</span>
                </div>
                <span class="badge green">Active</span>
            </div>
            <div class="cc-customer">Msobo Coal · Duff</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:42%"></i></div>
                <div class="cc-figures">
                    <span><b>840 t</b> delivered</span>
                    <span><b>1,160 t</b> remaining</span>
                    <span>of <b>2,000 t</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>Price / t</small><b>R1,310</b></div>
                <div><small>Type</small><b>Ad-hoc</b></div>
                <div><small>Ends</small><b>30 Sep 2026</b></div>
                <div><small>Account</small><b class="neg">On hold</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("ContractDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>SPOT-2026-009</b>
                    <span class="badge red">Spot sale</span>
                </div>
                <span class="badge green">Active</span>
            </div>
            <div class="cc-customer">Seriti Resources · Thermal coal</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:0%"></i></div>
                <div class="cc-figures">
                    <span><b>0 t</b> delivered</span>
                    <span><b>400 t</b> remaining</span>
                    <span>of <b>400 t</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>Price / t</small><b>R1,400</b></div>
                <div><small>Type</small><b>Spot</b></div>
                <div><small>Ends</small><b>31 Aug 2026</b></div>
                <div><small>Status</small><b class="pos">Active</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("ContractDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>SPOT-2026-010</b>
                    <span class="badge red">Spot sale</span>
                </div>
                <span class="badge green">Active</span>
            </div>
            <div class="cc-customer">Seriti Resources · Nuts</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:0%"></i></div>
                <div class="cc-figures">
                    <span><b>0 t</b> delivered</span>
                    <span><b>250 t</b> remaining</span>
                    <span>of <b>250 t</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>Price / t</small><b>R1,400</b></div>
                <div><small>Type</small><b>Spot</b></div>
                <div><small>Ends</small><b>31 Aug 2026</b></div>
                <div><small>Status</small><b class="pos">Active</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("ContractDetails", "Finance")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>SPOT-2026-005</b>
                    <span class="badge red">Spot sale</span>
                </div>
                <span class="badge green">Completed</span>
            </div>
            <div class="cc-customer">Eskom Arnot · Thermal coal</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:100%"></i></div>
                <div class="cc-figures">
                    <span><b>800 t</b> delivered</span>
                    <span><b>0 t</b> remaining</span>
                    <span>of <b>800 t</b></span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>Price / t</small><b>R1,400</b></div>
                <div><small>Type</small><b>Spot</b></div>
                <div><small>Ended</small><b>31 Jul 2026</b></div>
                <div><small>Status</small><b class="pos">Complete</b></div>
            </div>
        </a>

    </div>
</section>
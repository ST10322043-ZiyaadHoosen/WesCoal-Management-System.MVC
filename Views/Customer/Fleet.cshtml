@{
    ViewData["Title"] = "Weekly Fleet";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="fleet">
    <div class="page-heading">
        <div>
            <p class="eyebrow">WEEK COMMENCING 10 AUG 2026</p>
            <h1>Weekly Fleet</h1>
            <p>Authorised trucks and drivers for this week.</p>
        </div>
    </div>

    <!-- Readiness overview -->
    <div class="stat-grid">
        <article>
            <small>Authorised trucks</small>
            <strong>4</strong>
            <span>4 documents complete</span>
        </article>
        <article>
            <small>Authorised drivers</small>
            <strong>4</strong>
            <span>3 complete · 1 pending</span>
        </article>
        <article>
            <small>Cleared for collection</small>
            <strong>3</strong>
            <span>Drivers ready at the gate</span>
        </article>
        <article>
            <small>Needs attention</small>
            <strong class="highlight">1</strong>
            <span>Driver documents pending</span>
        </article>
    </div>

    <!-- Submit this week's fleet -->
    <article class="panel">
        <div class="panel-title">
            <h2>Submit this week's fleet</h2>
            <small class="field-note">Upload the list, then attach each driver's documents</small>
        </div>

        <p class="muted">
            Upload your weekly Excel or CSV file to import the truck and driver lists. After import,
            attach each driver's licence, ID and medical documents against their record below —
            documents are per driver, so they're attached to each record, not in the spreadsheet.
        </p>

        <div class="form-actions">
            <a class="btn-gold" asp-controller="Customer" asp-action="FleetUpload">Upload weekly fleet</a>
            <button class="btn-outline" data-toast="Previous week's fleet copied">Copy last week's list</button>
        </div>

        <small class="field-note">
            Trucks and drivers are authorised separately. Any authorised driver may use any authorised truck.
        </small>
    </article>

    <!-- AUTHORISED TRUCKS -->
    <article class="panel">
        <div class="panel-title">
            <h2>Authorised trucks</h2>
            <a class="btn-outline" style="padding:.5rem .9rem;" asp-controller="Customer" asp-action="FleetAddTruck">+ Add truck</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Truck</th>
                        <th>Trailer</th>
                        <th>Transporter</th>
                        <th>Licence disc</th>
                        <th>Documents</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>GP 12 TY LF</b></td>
                        <td>GP 77 TL GP</td>
                        <td>Bulk Haul Logistics</td>
                        <td>28 Feb 2027</td>
                        <td><span class="badge green">Complete</span></td>
                        <td><span class="badge green">Verified</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddTruck">Manage</a></td>
                    </tr>
                    <tr>
                        <td><b>NW 44 XZ LP</b></td>
                        <td>NW 55 TL LP</td>
                        <td>Transvaal Transport</td>
                        <td>31 Jan 2027</td>
                        <td><span class="badge green">Complete</span></td>
                        <td><span class="badge green">Verified</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddTruck">Manage</a></td>
                    </tr>
                    <tr>
                        <td><b>GP 22 ZZ MP</b></td>
                        <td>GP 33 TL MP</td>
                        <td>Bulk Haul Logistics</td>
                        <td>30 Apr 2027</td>
                        <td><span class="badge green">Complete</span></td>
                        <td><span class="badge green">Verified</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddTruck">Manage</a></td>
                    </tr>
                    <tr>
                        <td><b>MP 31 AB CD</b></td>
                        <td>MP 44 TL MP</td>
                        <td>Mpumalanga Carriers</td>
                        <td>31 Mar 2027</td>
                        <td><span class="badge green">Complete</span></td>
                        <td><span class="badge green">Verified</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddTruck">Manage</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>

    <!-- AUTHORISED DRIVERS -->
    <article class="panel">
        <div class="panel-title">
            <h2>Authorised drivers</h2>
            <a class="btn-outline" style="padding:.5rem .9rem;" asp-controller="Customer" asp-action="FleetAddDriver">+ Add driver</a>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Driver</th>
                        <th>Transporter</th>
                        <th>Licence</th>
                        <th>Medical expiry</th>
                        <th>Documents</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>Solomon Dube</b></td>
                        <td>Bulk Haul Logistics</td>
                        <td>Valid</td>
                        <td>30 Nov 2026</td>
                        <td><span class="badge green">Complete</span></td>
                        <td><span class="badge green">Cleared</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddDriver">Manage</a></td>
                    </tr>
                    <tr>
                        <td><b>Thabo Nkosi</b></td>
                        <td>Transvaal Transport</td>
                        <td>Valid</td>
                        <td>15 Sep 2026</td>
                        <td><span class="badge green">Complete</span></td>
                        <td><span class="badge green">Cleared</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddDriver">Manage</a></td>
                    </tr>
                    <tr>
                        <td><b>Johan Botha</b></td>
                        <td>Bulk Haul Logistics</td>
                        <td>Valid</td>
                        <td>22 Aug 2026</td>
                        <td><span class="badge green">Complete</span></td>
                        <td><span class="badge amber">Medical expiring</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddDriver">Manage</a></td>
                    </tr>
                    <tr>
                        <td><b>Sipho Mahlangu</b></td>
                        <td>Mpumalanga Carriers</td>
                        <td>Valid</td>
                        <td>10 Oct 2026</td>
                        <td><span class="badge red">Pending</span></td>
                        <td><span class="badge red">Not cleared</span></td>
                        <td><a asp-controller="Customer" asp-action="FleetAddDriver">Attach docs</a></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="field-note">
            A driver is only cleared for collection once all three documents (licence, ID, medical) are
            attached and current. Sipho Mahlangu is on the list but not yet cleared — documents pending.
            The weighbridge operator cannot pass a driver whose documents are incomplete or expired.
        </p>
    </article>
</section>
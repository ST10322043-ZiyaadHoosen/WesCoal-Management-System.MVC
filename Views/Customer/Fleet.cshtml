@{
    ViewData["Title"] = "Weekly Fleet";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="fleet">
    <div class="page-heading">
        <div>
            <p class="eyebrow">WEEK COMMENCING 10 AUG 2026</p>
            <h1>Weekly Fleet</h1>
            <p>Authorised trucks and drivers for this week.</p>
        </div>
    </div>

    <article class="panel">
        <div class="panel-title">
            <h2>Submit this week’s fleet</h2>
            <small class="field-note">One file or one click — no manual typing needed</small>
        </div>

        <p class="muted">
            Upload your weekly Excel or CSV file. The system reads the file and updates
            the authorised truck and driver lists automatically.
        </p>

        <div class="form-actions">
            <a class="btn-gold" asp-controller="Customer" asp-action="FleetUpload">Upload weekly fleet</a>
            <button class="btn-outline" data-toast="Previous week’s fleet copied">Copy last week’s list</button>
        </div>

        <small class="field-note">
            Trucks and drivers are authorised separately. Any authorised driver may use any authorised truck.
        </small>
    </article>

    <div class="content-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Authorised trucks</h2>
                <small class="field-note">This week’s list</small>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Truck</th>
                            <th>Trailer</th>
                            <th>Transporter</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><b>GP 12 TY LF</b></td>
                            <td>GP 77 TL GP</td>
                            <td>Bulk Haul Logistics</td>
                            <td><span class="badge green">Verified</span></td>
                        </tr>
                        <tr>
                            <td><b>NW 44 XZ LP</b></td>
                            <td>NW 55 TL LP</td>
                            <td>Transvaal Transport</td>
                            <td><span class="badge green">Verified</span></td>
                        </tr>
                        <tr>
                            <td><b>GP 22 ZZ MP</b></td>
                            <td>GP 33 TL MP</td>
                            <td>Bulk Haul Logistics</td>
                            <td><span class="badge green">Verified</span></td>
                        </tr>
                        <tr>
                            <td><b>MP 31 AB CD</b></td>
                            <td>MP 44 TL MP</td>
                            <td>Mpumalanga Carriers</td>
                            <td><span class="badge green">Verified</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>Authorised drivers</h2>
                <small class="field-note">This week’s list</small>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Driver</th>
                            <th>Transporter</th>
                            <th>Licence</th>
                            <th>Medical</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><b>Solomon Dube</b></td>
                            <td>Bulk Haul Logistics</td>
                            <td>Valid</td>
                            <td>30 Nov 2026</td>
                            <td><span class="badge green">Verified</span></td>
                        </tr>
                        <tr>
                            <td><b>Thabo Nkosi</b></td>
                            <td>Transvaal Transport</td>
                            <td>Valid</td>
                            <td>15 Sep 2026</td>
                            <td><span class="badge green">Verified</span></td>
                        </tr>
                        <tr>
                            <td><b>Johan Botha</b></td>
                            <td>Bulk Haul Logistics</td>
                            <td>Valid</td>
                            <td>22 Aug 2026</td>
                            <td><span class="badge amber">Expiring soon</span></td>
                        </tr>
                        <tr>
                            <td><b>Sipho Mahlangu</b></td>
                            <td>Mpumalanga Carriers</td>
                            <td>Valid</td>
                            <td>10 Oct 2026</td>
                            <td><span class="badge green">Verified</span></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </article>
    </div>

    <article class="panel">
        <div class="panel-title">
            <h2>Small changes only</h2>
            <small class="field-note">For mid-week corrections</small>
        </div>
        <p class="muted">
            If you only need to add or remove one truck or driver after submitting,
            use the options below. For larger changes, upload the updated weekly file again.
        </p>
        <div class="form-actions">
            <a class="btn-outline" asp-controller="Customer" asp-action="FleetAddTruck">Add truck</a>
            <a class="btn-outline" asp-controller="Customer" asp-action="FleetAddDriver">Add driver</a>
        </div>
    </article>
</section>
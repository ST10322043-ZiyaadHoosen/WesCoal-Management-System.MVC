@{
    ViewData["Title"] = "Upload Weekly Fleet";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="fleet-upload">
    <a class="back-link" asp-controller="Customer" asp-action="Fleet">← Weekly fleet</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">WEEK COMMENCING 10 AUG 2026</p>
            <h1>Upload Weekly Fleet</h1>
            <p>Step 1: import the list. Step 2: attach each driver's documents.</p>
        </div>
    </div>

    <!-- STEP 1: Upload -->
    <article class="panel">
        <div class="panel-title">
            <h2>1. Choose file</h2>
            <small class="field-note">Excel or CSV</small>
        </div>

        <form id="fleetUploadForm" class="form-card">
            <label class="full">
                Fleet file *
                <input type="file" id="fleetFile" accept=".xlsx,.xls,.csv" required>
                <small class="field-note">
                    Use the Wescoal template. Sheet 1: Trucks. Sheet 2: Drivers. The spreadsheet carries
                    the details only (registrations, ID, licence, medical expiry dates) — the actual
                    licence, ID and medical documents are attached per driver in step 3, because a file
                    can't live inside a spreadsheet cell.
                </small>
            </label>

            <div class="form-actions">
                <button class="btn-gold" id="readFileBtn">Read file</button>
            </div>
        </form>
    </article>

    <!-- STEP 2: Preview -->
    <article class="panel" id="previewPanel" style="display:none;">
        <div class="panel-title">
            <h2>2. Preview import</h2>
            <small class="field-note">System has read the file</small>
        </div>

        <div class="alert-box soft">
            <strong>Import preview</strong>
            <span id="previewSummary">4 trucks and 4 drivers found. Documents will be attached per record after import.</span>
        </div>

        <div class="content-grid">
            <div class="panel">
                <div class="panel-title"><h3>Trucks to import</h3></div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Registration</th>
                                <th>Transporter</th>
                                <th>Licence disc</th>
                                <th>Documents</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>GP 12 TY LF</td><td>Bulk Haul Logistics</td><td>28 Feb 2027</td><td><span class="badge amber">Pending</span></td></tr>
                            <tr><td>NW 44 XZ LP</td><td>Transvaal Transport</td><td>31 Jan 2027</td><td><span class="badge amber">Pending</span></td></tr>
                            <tr><td>GP 22 ZZ MP</td><td>Bulk Haul Logistics</td><td>30 Apr 2027</td><td><span class="badge amber">Pending</span></td></tr>
                            <tr><td>MP 31 AB CD</td><td>Mpumalanga Carriers</td><td>31 Mar 2027</td><td><span class="badge amber">Pending</span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="panel">
                <div class="panel-title"><h3>Drivers to import</h3></div>
                <div class="table-wrap">
                    <table>
                        <thead>
                            <tr>
                                <th>Driver</th>
                                <th>Transporter</th>
                                <th>Medical expiry</th>
                                <th>Documents</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td>Solomon Dube</td><td>Bulk Haul Logistics</td><td>30 Nov 2026</td><td><span class="badge amber">Pending</span></td></tr>
                            <tr><td>Thabo Nkosi</td><td>Transvaal Transport</td><td>15 Sep 2026</td><td><span class="badge amber">Pending</span></td></tr>
                            <tr><td>Johan Botha</td><td>Bulk Haul Logistics</td><td>22 Aug 2026</td><td><span class="badge amber">Pending</span></td></tr>
                            <tr><td>Sipho Mahlangu</td><td>Mpumalanga Carriers</td><td>10 Oct 2026</td><td><span class="badge amber">Pending</span></td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <p class="field-note">
            The system reads the expiry dates from the sheet and flags status automatically. Every
            imported record starts with documents <b>Pending</b> — you'll attach each driver's licence,
            ID and medical (and each truck's licence disc) against its record in the next step.
        </p>
    </article>

    <!-- STEP 3: Submit + attach -->
    <article class="panel" id="submitPanel" style="display:none;">
        <div class="panel-title">
            <h2>3. Import records &amp; attach documents</h2>
            <small class="field-note">Creates the records, then take you to attach documents</small>
        </div>

        <p class="muted">
            Confirming imports the trucks and drivers as this week's authorised lists. Each record is
            created with documents marked <b>Pending</b>. You'll then attach each driver's three
            documents (licence, ID, medical) and each truck's licence disc against its record on the
            fleet list. A driver is only cleared for collection once their documents are attached and current.
        </p>

        <div class="form-actions">
            <a class="btn-outline" asp-controller="Customer" asp-action="Fleet">Cancel</a>
            <button class="btn-gold" id="confirmBtn" disabled>Import &amp; attach documents</button>
        </div>
    </article>
</section>

@section Scripts {
    <script>
        (function () {
            const fileInput = document.getElementById('fleetFile');
            const readFileBtn = document.getElementById('readFileBtn');
            const previewPanel = document.getElementById('previewPanel');
            const submitPanel = document.getElementById('submitPanel');
            const confirmBtn = document.getElementById('confirmBtn');

            readFileBtn.addEventListener('click', function (e) {
                e.preventDefault();
                if (!fileInput.value) { alert('Please choose a file first.'); return; }

                readFileBtn.textContent = 'Reading file…';
                readFileBtn.disabled = true;

                setTimeout(function () {
                    readFileBtn.textContent = 'Read file';
                    readFileBtn.disabled = false;
                    previewPanel.style.display = 'block';
                    submitPanel.style.display = 'block';
                    confirmBtn.disabled = false;

                    const toast = document.querySelector('[data-toast-box]');
                    if (toast) {
                        toast.textContent = 'File read — 4 trucks, 4 drivers ready to import';
                        toast.classList.add('show');
                        setTimeout(() => toast.classList.remove('show'), 2200);
                    }
                }, 1200);
            });

            confirmBtn.addEventListener('click', function () {
                const toast = document.querySelector('[data-toast-box]');
                if (toast) {
                    toast.textContent = 'Records imported — attach documents per driver';
                    toast.classList.add('show');
                    setTimeout(() => toast.classList.remove('show'), 2500);
                }
            });
        })();
    </script>
}
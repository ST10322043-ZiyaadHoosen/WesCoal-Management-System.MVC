@{
    ViewData["Title"] = "Add Truck and Driver";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="fleet-edit">
    <button class="back-link" data-nav="fleet">← Weekly fleet</button>

    <div class="page-heading">
        <div>
            <p class="eyebrow">FLEET DETAILS</p>
            <h1>Add Truck and Driver</h1>
            <p>Submit compliance information for Logistics verification.</p>
        </div>
    </div>

    <form class="panel form-card" data-demo-form data-success="Fleet details submitted for Logistics verification">
        <div class="form-grid">
            <label>
                Truck registration *
                <input required placeholder="MP 45 TR GP">
            </label>

            <label>
                Trailer registration
                <input placeholder="MP 67 TL GP">
            </label>

            <label>
                Driver name *
                <input required placeholder="Full name">
            </label>

            <label>
                ID number *
                <input required placeholder="South African ID">
            </label>

            <label>
                Licence number *
                <input required>
            </label>

            <label>
                Medical expiry *
                <input required type="date">
            </label>

            <label>
                Driver licence upload
                <input type="file" accept=".pdf,.jpg,.jpeg,.png">
                <small class="field-note">Attach a valid driver’s licence for the named driver.</small>
            </label>

            <label>
                Medical certificate upload
                <input type="file" accept=".pdf,.jpg,.jpeg,.png">
                <small class="field-note">Attach the medical fitness certificate for the named driver.</small>
            </label>
        </div>

        <div class="info-box">
            Submitted fleet details are held against the customer’s weekly fleet list.
            Logistics verifies the driver and truck before gate access is allowed.
        </div>

        <div class="form-actions">
            <button type="button" class="btn-outline" data-nav="fleet">Cancel</button>
            <button class="btn-gold">Submit fleet details</button>
        </div>
    </form>
</section>
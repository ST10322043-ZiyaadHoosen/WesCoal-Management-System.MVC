@{
    ViewData["Title"] = "Coal Supply Agreement";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="contract-detail">
    <button class="back-link" data-nav="contracts">← My contracts</button>
    <div class="page-heading">
        <div>
            <p class="eyebrow">CONTRACT CSA-2026-001</p>
            <h1>Coal Supply Agreement</h1>
            <p>Thermal coal · 01 Jan–31 Dec 2026</p>
        </div>
        <span class="badge green">Active</span>
    </div>
    <div class="stat-grid">
        <article>
            <small>Total</small>
            <strong>5,000 t</strong>
        </article>
        <article>
            <small>Delivered</small>
            <strong>3,400 t</strong>
        </article>
        <article>
            <small>Remaining</small>
            <strong>1,600 t</strong>
        </article>
        <article>
            <small>Price</small>
            <strong>R1,250/t</strong>
        </article>
    </div>
    <article class="panel">
        <h2>Contract progress</h2>
        <div class="progress large">
            <i style="width:68%">
            </i>
        </div>
        <div class="split-label">
            <span>3,400 t delivered</span>
            <b>68%</b>
            <span>1,600 t remaining</span>
        </div>
        <div class="info-box">Contract information is read-only. Contact Wescoal Sales if a change is required.</div>
    </article>
</section>


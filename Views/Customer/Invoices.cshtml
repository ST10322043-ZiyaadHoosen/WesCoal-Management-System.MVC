@{
    ViewData["Title"] = "Invoices";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="invoices">
    <div class="page-heading">
        <div>
            <p class="eyebrow">BILLING</p>
            <h1>Invoices</h1>
            <p>View invoices and payment due dates.</p>
        </div>
    </div>
    <article class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Order</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Due date</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-nav="invoice-detail">
                        <td>
                            <b>INV-2026-084</b>
                        </td>
                        <td>PO-1042</td>
                        <td>12 Aug 2026</td>
                        <td>R625,000</td>
                        <td>30 Aug 2026</td>
                        <td>
                            <span class="badge amber">Unpaid</span>
                        </td>
                    </tr>
                    <tr data-nav="invoice-detail">
                        <td>
                            <b>INV-2026-071</b>
                        </td>
                        <td>PO-1039</td>
                        <td>31 Jul 2026</td>
                        <td>R625,000</td>
                        <td>07 Aug 2026</td>
                        <td>
                            <span class="badge green">Paid</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>
</section>


@{
    ViewData["Title"] = "My Profile";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="profile">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ACCOUNT</p>
            <h1>My Profile</h1>
            <p>Company information and contact details.</p>
        </div>
        <span class="badge green">Account active</span>
    </div>

    <div class="detail-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Company details</h2>
                <small class="field-note">Read-only</small>
            </div>

            <dl>
                <dt>Company name</dt>
                <dd>Eskom Arnot</dd>

                <dt>Site / location</dt>
                <dd>Arnot Power Station, Mpumalanga</dd>

                <dt>VAT number</dt>
                <dd>4230187456</dd>

                <dt>Account status</dt>
                <dd><span class="badge green">Active</span></dd>
            </dl>

            <p class="field-note">
                Company name, VAT number, and account status are managed by Wescoal Sales or Finance.
            </p>
        </article>

        <form class="panel form-card" data-demo-form data-success="Profile updated successfully">
            <div class="panel-title">
                <h2>Contact details</h2>
                <small class="field-note">Editable by you</small>
            </div>

            <div class="form-grid">
                <label>
                    Contact person *
                    <input required value="Thabo Mokoena">
                </label>

                <label>
                    Email address *
                    <input required type="email" value="thabo.mokoena@eskom.co.za">
                </label>

                <label>
                    Phone number *
                    <input required value="+27 13 297 1000">
                </label>

                <label>
                    Alternative contact number
                    <input placeholder="Optional">
                </label>
            </div>

            <div class="info-box">
                This contact information is used for order, invoice, and fleet notifications.
                Keep it up to date so Wescoal can reach the right person.
            </div>

            <div class="form-actions">
                <a class="btn-outline" asp-controller="Customer" asp-action="Index">Cancel</a>
                <button class="btn-gold">Save changes</button>
            </div>
        </form>
    </div>
</section>
@{
    ViewData["Title"] = "Add Truck";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="fleet-add-truck">
    <a class="back-link" asp-controller="Customer" asp-action="Fleet">← Weekly fleet</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">FLEET DETAILS</p>
            <h1>Add Truck</h1>
            <p>Add one truck to this week's authorised truck list.</p>
        </div>
    </div>

    <form class="panel form-card" data-demo-form data-success="Truck added to this week's fleet list">

        <h2 class="form-section">Truck details</h2>
        <div class="form-grid">
            <label>
                Truck registration *
                <input required placeholder="e.g. GP 12 TY LF">
            </label>
            <label>
                Trailer registration
                <input placeholder="e.g. GP 77 TL GP">
            </label>
            <label>
                Transporter / Logistics company *
                <select required>
                    <option>Select transporter</option>
                    <option>Bulk Haul Logistics</option>
                    <option>Transvaal Transport</option>
                    <option>Mpumalanga Carriers</option>
                    <option>Other</option>
                </select>
                <small class="field-note">The transport company that owns or operates this truck.</small>
            </label>
            <label>
                Licence disc expiry *
                <input required type="date">
                <small class="field-note">The system flags trucks whose licence disc is expiring or expired.</small>
            </label>
        </div>

        <hr>

        <h2 class="form-section">Supporting documents</h2>
        <p class="field-note" style="margin-bottom:1rem;">
            Attach the truck's licence disc as proof of a roadworthy, registered vehicle.
        </p>
        <div class="form-grid">
            <label class="full">
                Licence disc / roadworthy *
                <input required type="file" accept=".pdf,.jpg,.jpeg,.png">
                <small class="field-note">Proof of the licence disc expiry entered above.</small>
            </label>
        </div>

        <div class="info-box">
            This truck is added to the authorised truck list independently of any driver.
            Any authorised driver may use any authorised truck.
        </div>

        <div class="form-actions">
            <a class="btn-outline" asp-controller="Customer" asp-action="Fleet">Cancel</a>
            <button class="btn-gold">Submit truck</button>
        </div>
    </form>
</section>
@{
    ViewData["Title"] = "My Purchase Orders";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="orders">
    <div class="page-heading">
        <div>
            <p class="eyebrow">COLLECTIONS</p>
            <h1>My Purchase Orders</h1>
            <p>Track delivered tonnage and remaining collections.</p>
        </div>
    </div>

    <article class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Contract</th>
                        <th>Ordered</th>
                        <th>Delivered</th>
                        <th>Remaining</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr onclick="location.href='@Url.Action("OrderDetails", "Customer")'" style="cursor:pointer;">
                        <td>
                            <b>PO-1042</b>
                        </td>
                        <td>CSA-2026-001</td>
                        <td>500 t</td>
                        <td>340 t</td>
                        <td>160 t</td>
                        <td>
                            <span class="badge blue">In progress</span>
                        </td>
                    </tr>
                    <tr onclick="location.href='@Url.Action("OrderDetails", "Customer")'" style="cursor:pointer;">
                        <td>
                            <b>PO-1039</b>
                        </td>
                        <td>CSA-2026-001</td>
                        <td>480 t</td>
                        <td>480 t</td>
                        <td>0 t</td>
                        <td>
                            <span class="badge green">Fulfilled</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="field-note">
            Only your own orders are shown. Collections are updated automatically
            from weighbridge transactions as trucks complete their loads.
        </p>
    </article>
</section>
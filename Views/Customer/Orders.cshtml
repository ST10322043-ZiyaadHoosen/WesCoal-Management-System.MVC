@{
    ViewData["Title"] = "My Purchase Orders";
    ViewData["RoleName"] = "Customer User";
    ViewData["RoleSubtitle"] = "Customer Portal";
    ViewData["Initials"] = "CU";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="orders">
    <div class="page-heading">
        <div>
            <p class="eyebrow">COLLECTIONS</p>
            <h1>My Purchase Orders</h1>
            <p>Track delivered tonnage and remaining collections.</p>
        </div>
    </div>

    <div class="stat-grid">
        <article>
            <small>Active orders</small>
            <strong>1</strong>
            <span>In progress</span>
        </article>
        <article>
            <small>Delivered this month</small>
            <strong>340 t</strong>
            <span>Across active orders</span>
        </article>
        <article>
            <small>Remaining to collect</small>
            <strong>160 t</strong>
            <span>On PO-1042</span>
        </article>
        <article>
            <small>Fulfilled orders</small>
            <strong>1</strong>
            <span>PO-1039 complete</span>
        </article>
    </div>

    <div class="contract-list">

        <a class="contract-card" onclick="location.href='@Url.Action("OrderDetails", "Customer")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>PO-1042</b>
                    <span class="badge red">CSA-2026-001</span>
                </div>
                <span class="badge blue">In progress</span>
            </div>
            <div class="cc-customer">Thermal coal</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:68%"></i></div>
                <div class="cc-figures">
                    <span><b>340 t</b> delivered</span>
                    <span><b>160 t</b> remaining</span>
                    <span>of <b>500 t</b> ordered</span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>Ordered</small><b>500 t</b></div>
                <div><small>Delivered</small><b>340 t</b></div>
                <div><small>Truck visits</small><b>12</b></div>
                <div><small>Status</small><b class="pos">In progress</b></div>
            </div>
        </a>

        <a class="contract-card" onclick="location.href='@Url.Action("OrderDetails", "Customer")'">
            <div class="cc-head">
                <div class="cc-id">
                    <b>PO-1039</b>
                    <span class="badge red">CSA-2026-001</span>
                </div>
                <span class="badge green">Fulfilled</span>
            </div>
            <div class="cc-customer">Thermal coal</div>
            <div class="cc-progress">
                <div class="progress"><i style="width:100%"></i></div>
                <div class="cc-figures">
                    <span><b>480 t</b> delivered</span>
                    <span><b>0 t</b> remaining</span>
                    <span>of <b>480 t</b> ordered</span>
                </div>
            </div>
            <div class="cc-meta">
                <div><small>Ordered</small><b>480 t</b></div>
                <div><small>Delivered</small><b>480 t</b></div>
                <div><small>Truck visits</small><b>16</b></div>
                <div><small>Status</small><b class="pos">Complete</b></div>
            </div>
        </a>

    </div>

    <p class="field-note" style="margin-top:1.3rem;">
        Orders are arranged with Wescoal Sales. Each order is collected by your authorised trucks at the
        weighbridge, and you are invoiced on the actual tonnage delivered.
    </p>
</section>
@{
    ViewData["Title"] = "Available Orders";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="available-orders">
    <div class="page-heading">
        <div>
            <p class="eyebrow">SAP-ATTACHED ORDERS</p>
            <h1>Available Orders</h1>
            <p>Orders ready for collection at the weighbridge.</p>
        </div>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search order, customer or product…">
            <select>
                <option>All statuses</option>
                <option>Ready</option>
                <option>In progress</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Product</th>
                        <th>Remaining</th>
                        <th>Fleet status</th>
                        <th>Order status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr onclick="location.href='@Url.Action("OrderDetails", "Logistics")'" style="cursor:pointer;">
                        <td>
                            <b>PO-1042</b>
                        </td>
                        <td>Eskom Arnot</td>
                        <td>Thermal coal</td>
                        <td>160 t</td>
                        <td>
                            <span class="badge green">Verified</span>
                        </td>
                        <td>
                            <span class="badge blue">In progress</span>
                        </td>
                    </tr>
                    <tr onclick="location.href='@Url.Action("OrderDetails", "Logistics")'" style="cursor:pointer;">
                        <td>
                            <b>PO-1045</b>
                        </td>
                        <td>Seriti Resources</td>
                        <td>Nuts</td>
                        <td>400 t</td>
                        <td>
                            <span class="badge green">Verified</span>
                        </td>
                        <td>
                            <span class="badge green">Ready</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="field-note">
            Only SAP-attached orders with a verified weekly fleet list are shown here.
            Blocked or on-hold customers do not appear in this list.
            The operator never sees pricing or financial values.
        </p>
    </article>
</section>
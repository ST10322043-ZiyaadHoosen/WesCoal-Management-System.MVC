@{
    ViewData["Title"] = "Weigh In";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="weigh-in">
    <a class="back-link" asp-controller="Logistics" asp-action="GateCheck">← Gate check</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">WEIGHBRIDGE STEP 1 OF 2</p>
            <h1>Weigh In</h1>
            <p>Record the empty truck weight.</p>
        </div>
    </div>

    <div class="panel form-card">
        <div class="form-grid">
            <label>
                Truck
                <input readonly value="GP 12 TY LF">
            </label>

            <label>
                Driver
                <input readonly value="Solomon Dube">
            </label>

            <label>
                Transporter
                <input readonly value="Bulk Haul Logistics">
            </label>

            <label>
                Product / material
                <input readonly value="Thermal coal">
            </label>

            <label>
                Destination
                <input value="Arnot Power Station">
            </label>

            <label>
                Stockpile
                <input placeholder="e.g. SP-3">
            </label>

            <label>
                Delivery note / reference
                <input placeholder="DN-…">
            </label>

            <label>
                Waybill
                <input readonly value="WB-2026-2409">
            </label>

            <label>
                Weigh-in weight (t) *
                <input required type="number" step="0.01" value="22.40">
            </label>

            <label>
                Date and time
                <input type="datetime-local" value="2026-08-12T06:12">
            </label>

            <label class="full">
                Upload weigh-in slip *
                <input type="file" accept=".pdf,.jpg,.jpeg,.png" required>
                <small class="field-note">Attach the scanned or digital weighbridge slip for this empty weight.</small>
            </label>
        </div>

        <div class="info-box">
            This weigh-in is the empty/tare weight. The loaded weight will be captured on return from the stockpile.
        </div>

        <div class="form-actions">
            <a class="btn-outline" asp-controller="Logistics" asp-action="GateCheck">Back</a>
            <a class="btn-gold" asp-controller="Logistics" asp-action="WeighOut">Record weigh-in</a>
        </div>
    </div>
</section>
@{
    ViewData["Title"] = "Transaction Summary";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="summary">
    <div class="page-heading">
        <div>
            <p class="eyebrow">COLLECTION COMPLETE</p>
            <h1>Transaction Summary</h1>
            <p>Review the completed collection.</p>
        </div>
        <span class="badge green">Recorded</span>
    </div>

    <div class="stat-grid">
        <article>
            <small>Weigh-in</small>
            <strong>22.40 t</strong>
        </article>
        <article>
            <small>Weigh-out</small>
            <strong>51.00 t</strong>
        </article>
        <article>
            <small>Net tonnage</small>
            <strong>28.60 t</strong>
        </article>
        <article>
            <small>Order remaining after load</small>
            <strong>131.40 t</strong>
        </article>
    </div>

    <article class="panel">
        <dl>
            <dt>Transaction</dt>
            <dd>WB-2026-2409</dd>

            <dt>Order</dt>
            <dd>PO-1042</dd>

            <dt>Customer</dt>
            <dd>Eskom Arnot</dd>

            <dt>Truck</dt>
            <dd>GP 12 TY LF</dd>

            <dt>Driver</dt>
            <dd>Solomon Dube</dd>

            <dt>Transporter</dt>
            <dd>Bulk Haul Logistics</dd>

            <dt>Product</dt>
            <dd>Thermal coal</dd>
        </dl>

        <div class="alert-box soft">
            <strong>Order check passed</strong>
            <span>
                Net load 28.60 t deducted from order balance 160 t. Remaining balance is now 131.40 t.
            </span>
        </div>

        <div class="form-actions">
            <button class="btn-outline" data-toast="Weighbridge slip generated">Print weighbridge slip</button>
            <a class="btn-gold" asp-controller="Logistics" asp-action="AvailableOrders">Finish</a>
        </div>
    </article>
</section>
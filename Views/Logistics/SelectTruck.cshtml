@{
    ViewData["Title"] = "Select Truck";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="truck-select">
    <button class="back-link" data-nav="collection-type">← Collection type</button>
    <div class="page-heading">
        <div>
            <p class="eyebrow">AUTHORISED FLEET</p>
            <h1>Select Truck</h1>
            <p>Choose a truck from Eskom Arnot's weekly fleet.</p>
        </div>
    </div>
    <article class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Registration</th>
                        <th>Trailer</th>
                        <th>Driver</th>
                        <th>Licence</th>
                        <th>Medical</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-nav="gate-check">
                        <td>
                            <b>MP 45 TR GP</b>
                        </td>
                        <td>MP 67 TL GP</td>
                        <td>Joseph Dlamini</td>
                        <td>Valid</td>
                        <td>30 Nov 2026</td>
                        <td>
                            <span class="badge green">Approved</span>
                        </td>
                    </tr>
                    <tr data-nav="gate-check">
                        <td>
                            <b>MP 12 AB GP</b>
                        </td>
                        <td>MP 34 CD GP</td>
                        <td>Simon Khumalo</td>
                        <td>Valid</td>
                        <td>22 Aug 2026</td>
                        <td>
                            <span class="badge amber">Check certificate</span>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>
</section>


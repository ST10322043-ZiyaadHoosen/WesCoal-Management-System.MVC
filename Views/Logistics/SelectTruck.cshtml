@{
    ViewData["Title"] = "Select Truck";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="truck-select">
    <button class="back-link" data-nav="collection-type">← Collection type</button>
    <div class="page-heading">
        <div>
            <p class="eyebrow">AUTHORISED FLEET</p>
            <h1>Select Truck</h1>
            <p>Choose the truck that arrived, from Eskom Arnot's weekly fleet.</p>
        </div>
    </div>
    <article class="panel">
        <p class="field-note">
            Select the truck only. The driver is chosen next, at the gate check, from the customer's
            authorised driver list — any authorised driver may operate any authorised truck.
        </p>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Registration</th>
                        <th>Trailer</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr data-nav="gate-check">
                        <td>
                            <b>MP 45 TR GP</b>
                        </td>
                        <td>MP 67 TL GP</td>
                        <td>
                            <span class="badge green">Verified</span>
                        </td>
                        <td>›</td>
                    </tr>
                    <tr data-nav="gate-check">
                        <td>
                            <b>MP 12 AB GP</b>
                        </td>
                        <td>MP 34 CD GP</td>
                        <td>
                            <span class="badge green">Verified</span>
                        </td>
                        <td>›</td>
                    </tr>
                    <tr data-nav="gate-check">
                        <td>
                            <b>MP 88 KL GP</b>
                        </td>
                        <td>MP 89 KL GP</td>
                        <td>
                            <span class="badge green">Verified</span>
                        </td>
                        <td>›</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>
</section>
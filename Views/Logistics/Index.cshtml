@{
    ViewData["Title"] = "Weighbridge Dashboard";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="dashboard">
    <div class="page-heading">
        <div>
            <p class="eyebrow">LIVE OPERATIONS</p>
            <h1>Weighbridge Dashboard</h1>
            <p>Gate operations, collections and daily weighing log.</p>
        </div>
        <a class="btn-gold" asp-controller="Logistics" asp-action="AvailableOrders">Start collection</a>
    </div>

    <div class="stat-grid">
        <article>
            <small>Available orders</small>
            <strong>2</strong>
            <span>Ready to collect</span>
        </article>
        <article>
            <small>Today's loads</small>
            <strong>12</strong>
            <span>340 t recorded</span>
        </article>
        <article>
            <small>Trucks on site</small>
            <strong>2</strong>
            <span>1 loading, 1 weighing</span>
        </article>
        <article>
            <small>Blocked collections</small>
            <strong>1</strong>
            <span>Customer on hold</span>
        </article>
    </div>

    <div class="content-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Available orders</h2>
                <a class="btn-outline" asp-controller="Logistics" asp-action="AvailableOrders">View all</a>
            </div>
            <div class="mini-table">
                <a asp-controller="Logistics" asp-action="OrderDetails">
                    <b>PO-1042</b>
                    <span>Eskom Arnot · 160 t left</span>
                    <em class="badge blue">In progress</em>
                </a>
                <a asp-controller="Logistics" asp-action="OrderDetails">
                    <b>PO-1045</b>
                    <span>Seriti Resources · 400 t</span>
                    <em class="badge green">Ready</em>
                </a>
            </div>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>Today's activity</h2>
                <a class="btn-outline" asp-controller="Logistics" asp-action="WeighbridgeLog">View log</a>
            </div>
            <div class="mini-table">
                <div>
                    <b>WB-2408</b>
                    <span>GP 12 TY LF · 28.6 t</span>
                    <em class="badge green">Complete</em>
                </div>
                <div>
                    <b>WB-2407</b>
                    <span>NW 44 XZ LP · 29.3 t</span>
                    <em class="badge green">Complete</em>
                </div>
            </div>
        </article>
    </div>
</section>
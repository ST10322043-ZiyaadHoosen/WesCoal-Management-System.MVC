@{
    ViewData["Title"] = "Weighbridge Dashboard";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="dashboard">
    <div class="page-heading">
        <div>
            <p class="eyebrow">LIVE OPERATIONS</p>
            <h1>Weighbridge Dashboard</h1>
            <p>Gate operations, collections and daily weighing log.</p>
        </div>
        <button class="btn-gold" data-nav="available-orders">Start collection</button>
    </div>
    <div class="stat-grid">
        <article>
            <small>Available orders</small>
            <strong>4</strong>
            <span>Ready to collect</span>
        </article>
        <article>
            <small>Today's loads</small>
            <strong>12</strong>
            <span>340 t recorded</span>
        </article>
        <article>
            <small>Trucks on site</small>
            <strong>2</strong>
            <span>1 loading, 1 weighing</span>
        </article>
        <article>
            <small>Blocked collections</small>
            <strong>1</strong>
            <span>Customer on hold</span>
        </article>
    </div>
    <div class="content-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Available orders</h2>
                <button data-nav="available-orders">View all</button>
            </div>
            <div class="mini-table">
                <button data-nav="order-detail">
                    <b>PO-1042</b>
                    <span>Eskom Arnot · 160 t left</span>
                    <em class="badge blue">In progress</em>
                </button>
                <button data-nav="order-detail">
                    <b>PO-1045</b>
                    <span>Seriti Resources · 400 t</span>
                    <em class="badge green">Active</em>
                </button>
            </div>
        </article>
        <article class="panel">
            <div class="panel-title">
                <h2>Today's activity</h2>
                <button data-nav="log">View log</button>
            </div>
            <div class="mini-table">
                <button>
                    <b>WB-2408</b>
                    <span>MP 45 TR GP · 34.2 t</span>
                    <em class="badge green">Complete</em>
                </button>
                <button>
                    <b>WB-2407</b>
                    <span>MP 12 AB GP · 33.8 t</span>
                    <em class="badge green">Complete</em>
                </button>
            </div>
        </article>
    </div>
</section>


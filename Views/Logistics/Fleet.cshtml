@{
    ViewData["Title"] = "Customer Fleet";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="fleet">
    <div class="page-heading">
        <div>
            <p class="eyebrow">COMPLIANCE</p>
            <h1>Customer Fleet</h1>
            <p>Weekly authorised trucks and drivers per customer.</p>
        </div>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search customer, truck or driver…">
            <select>
                <option>All customers</option>
                <option>Eskom Arnot</option>
                <option>Seriti Resources</option>
            </select>
        </div>
        <p class="field-note">
            Click a truck or driver to view their uploaded compliance documents before gate entry.
        </p>
    </article>

    <div class="content-grid">
        <!-- Trucks -->
        <article class="panel">
            <div class="panel-title">
                <h2>Authorised trucks</h2>
                <small class="field-note">View licence disc / roadworthy</small>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Truck</th>
                            <th>Transporter</th>
                            <th>Documents</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>GP 12 TY LF</b></td>
                            <td>Bulk Haul Logistics</td>
                            <td><span class="badge green">Complete</span></td>
                            <td><span class="badge green">Verified</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="TruckDetails">View</a></td>
                        </tr>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>NW 44 XZ LP</b></td>
                            <td>Transvaal Transport</td>
                            <td><span class="badge green">Complete</span></td>
                            <td><span class="badge green">Verified</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="TruckDetails">View</a></td>
                        </tr>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>GP 22 ZZ MP</b></td>
                            <td>Bulk Haul Logistics</td>
                            <td><span class="badge green">Complete</span></td>
                            <td><span class="badge green">Verified</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="TruckDetails">View</a></td>
                        </tr>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>MP 31 AB CD</b></td>
                            <td>Mpumalanga Carriers</td>
                            <td><span class="badge green">Complete</span></td>
                            <td><span class="badge green">Verified</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="TruckDetails">View</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </article>

        <!-- Drivers -->
        <article class="panel">
            <div class="panel-title">
                <h2>Authorised drivers</h2>
                <small class="field-note">View licence, ID, medical</small>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Customer</th>
                            <th>Driver</th>
                            <th>Transporter</th>
                            <th>Documents</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>Solomon Dube</b></td>
                            <td>Bulk Haul Logistics</td>
                            <td><span class="badge green">Complete</span></td>
                            <td><span class="badge green">Cleared</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="DriverDetails">View</a></td>
                        </tr>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>Thabo Nkosi</b></td>
                            <td>Transvaal Transport</td>
                            <td><span class="badge green">Complete</span></td>
                            <td><span class="badge green">Cleared</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="DriverDetails">View</a></td>
                        </tr>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>Johan Botha</b></td>
                            <td>Bulk Haul Logistics</td>
                            <td><span class="badge green">Complete</span></td>
                            <td><span class="badge amber">Medical expiring soon</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="DriverDetails">View</a></td>
                        </tr>
                        <tr>
                            <td>Eskom Arnot</td>
                            <td><b>Sipho Mahlangu</b></td>
                            <td>Mpumalanga Carriers</td>
                            <td><span class="badge red">Pending</span></td>
                            <td><span class="badge red">Not cleared</span></td>
                            <td><a class="btn-outline" style="padding:.4rem .8rem;" asp-controller="Logistics" asp-action="DriverDetails">View</a></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </article>
    </div>

    <p class="field-note">
        A driver is only cleared once licence, ID, and medical documents are attached and current.
        Trucks require a current licence disc. Click a record to view the actual uploaded documents.
    </p>
</section>
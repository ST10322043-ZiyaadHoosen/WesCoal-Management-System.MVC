@{
    ViewData["Title"] = "Truck & Driver Check";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="gate-check">
    <a class="back-link" asp-controller="Logistics" asp-action="SelectTruck">← Select truck</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">GATE VERIFICATION</p>
            <h1>Truck &amp; Driver Check</h1>
            <p>GP 12 TY LF · Bulk Haul Logistics · Eskom Arnot</p>
        </div>
        <span class="badge green">Verified</span>
    </div>

    <div class="panel form-card">
        <div class="form-grid">
            <label>
                Truck (selected)
                <input value="GP 12 TY LF — Bulk Haul Logistics" readonly>
            </label>

            <label>
                Driver at the gate *
                <select id="driverSelect" required>
                    <option value="">Select the driver who arrived…</option>
                    <option>Solomon Dube — Bulk Haul Logistics</option>
                    <option>Thabo Nkosi — Transvaal Transport</option>
                    <option>Johan Botha — Bulk Haul Logistics</option>
                    <option>Sipho Mahlangu — Mpumalanga Carriers</option>
                </select>
            </label>

            <label>
                Waybill number *
                <input required value="WB-2026-2409">
            </label>
        </div>

        <p class="field-note">
            The driver is selected from the customer's authorised driver list. Any authorised driver may
            operate any authorised truck for the same customer. The truck and driver are paired here for
            this collection only.
        </p>

        <hr>

        <div class="info-box">
            This truck and driver are on the customer's authorised fleet list, with their documents
            (licence, ID, medical) held on the system. The operator confirms the arriving driver matches
            the record and checks the truck's physical condition before proceeding.
        </div>

        <div class="form-grid top-gap">
            <label>
                Truck condition
                <select>
                    <option>Good</option>
                    <option>Minor concern noted</option>
                    <option>Unsafe</option>
                </select>
            </label>

            <label class="full">
                Inspection notes
                <textarea rows="3" placeholder="Optional notes"></textarea>
            </label>
        </div>

        <div class="form-actions">
            <a class="btn-outline" asp-controller="Logistics" asp-action="AvailableOrders">Cancel</a>
            <a class="btn-gold" asp-controller="Logistics" asp-action="WeighIn">Continue to weigh-in</a>
        </div>
    </div>
</section>
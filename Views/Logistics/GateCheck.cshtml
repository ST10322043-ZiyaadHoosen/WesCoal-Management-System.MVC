@{
    ViewData["Title"] = "Truck & Driver Check";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="gate-check">
    <a class="back-link" asp-controller="Logistics" asp-action="SelectTruck">← Select truck</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">GATE VERIFICATION</p>
            <h1>Truck & Driver Check</h1>
            <p>GP 12 TY LF · Eskom Arnot</p>
        </div>
    </div>

    <form class="panel form-card" data-demo-form data-success="Gate check passed">

        <div class="form-grid">
            <label>
                Truck (selected)
                <input value="GP 12 TY LF" readonly>
            </label>
            <label>
                Driver at the gate *
                <select required>
                    <option value="">Select the driver who arrived…</option>
                    <option>Solomon Dube</option>
                    <option>Thabo Nkosi</option>
                    <option>Petrus van Wyk (substitute)</option>
                </select>
            </label>
        </div>
        <p class="field-note">
            The driver is selected from the customer's authorised driver list — any authorised
            driver (including substitutes) may operate this truck. The truck and driver are paired
            here for this collection.
        </p>

        <hr>

        <div class="check-list">
            <label class="check-row">
                <input required type="checkbox"> Truck appears on the verified weekly fleet list
            </label>
            <label class="check-row">
                <input required type="checkbox"> Selected driver is on the authorised driver list
            </label>
            <label class="check-row">
                <input required type="checkbox"> Driver identity and licence verified
            </label>
            <label class="check-row">
                <input required type="checkbox"> Medical certificate is valid
            </label>
            <label class="check-row">
                <input required type="checkbox"> Truck condition is safe for loading
            </label>
        </div>

        <div class="form-grid top-gap">
            <label>
                Truck condition
                <select>
                    <option>Good</option>
                    <option>Minor concern noted</option>
                    <option>Unsafe</option>
                </select>
            </label>

            <label class="full">
                Inspection notes
                <textarea rows="3" placeholder="Optional notes"></textarea>
            </label>
        </div>

        <div class="form-actions">
            <a class="btn-outline" asp-controller="Logistics" asp-action="AvailableOrders">Cancel</a>
            <button class="btn-gold" type="submit">Continue to weigh-in</button>
        </div>
    </form>
</section>
@{
    ViewData["Title"] = "Weigh Out";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="weigh-out">
    <a class="back-link" asp-controller="Logistics" asp-action="WeighIn">← Weigh-in</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">WEIGHBRIDGE STEP 2 OF 2</p>
            <h1>Weigh Out</h1>
            <p>Record the loaded weight and calculate net tonnage.</p>
        </div>
    </div>

    <form class="panel form-card" data-demo-form data-success="Weigh-out recorded — transaction complete">
        <div class="form-grid">
            <label>
                Truck
                <input readonly value="GP 12 TY LF">
            </label>

            <label>
                Driver
                <input readonly value="Solomon Dube">
            </label>

            <label>
                Weigh-in weight
                <input readonly value="22.40 t">
            </label>

            <label>
                Weigh-out weight (t) *
                <input required type="number" step="0.01" id="weighOutWeight" value="51.00">
            </label>

            <label>
                Calculated net weight
                <input readonly id="netWeight" value="28.60 t">
            </label>

            <label>
                Date and time
                <input type="datetime-local" value="2026-08-12T06:54">
            </label>

            <label class="full">
                Upload weigh-out slip *
                <input type="file" accept=".pdf,.jpg,.jpeg,.png" required>
                <small class="field-note">Attach the scanned or digital weighbridge slip for this loaded weight.</small>
            </label>
        </div>

        <div class="alert-box soft">
            <strong>Order check</strong>
            <span>Net load 28.60 t is below the remaining order balance of 160 t. Collection may proceed.</span>
        </div>

        <div class="form-actions">
            <a class="btn-outline" asp-controller="Logistics" asp-action="WeighIn">Back</a>
            <button class="btn-gold" type="submit">Complete weighing</button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (function () {
            const weighOutInput = document.getElementById('weighOutWeight');
            const netInput = document.getElementById('netWeight');
            const weighIn = 22.40;

            if (weighOutInput && netInput) {
                weighOutInput.addEventListener('input', function () {
                    const weighOut = parseFloat(this.value) || 0;
                    const net = weighOut - weighIn;
                    netInput.value = net > 0 ? net.toFixed(2) + ' t' : '0.00 t';
                });
            }
        })();
    </script>
}
@{
    ViewData["Title"] = "Collection Type";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="collection-type">
    <a class="back-link" asp-controller="Logistics" asp-action="OrderDetails">← Order details</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">PO-1042 · THERMAL COAL</p>
            <h1>Collection Type</h1>
            <p>Standard coal sale order.</p>
        </div>
    </div>

    <div class="choice-grid">
        <a class="choice-card" asp-controller="Logistics" asp-action="SelectTruck">
            <strong>Standard coal collection</strong>
            <span>Empty weigh-in, load coal, loaded weigh-out.</span>
        </a>

        <div class="choice-card" style="opacity:.5; cursor:not-allowed;">
            <strong>Coal washing service</strong>
            <span>Not available for this order. Washing services are recorded against a separate washing service order.</span>
        </div>
    </div>
</section>
@{
    ViewData["Title"] = "Weighbridge Log";
    ViewData["RoleName"] = "Weighbridge Operator";
    ViewData["RoleSubtitle"] = "Logistics & Weighbridge";
    ViewData["Initials"] = "WO";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="log">
    <div class="page-heading">
        <div>
            <p class="eyebrow">AUDITABLE RECORD</p>
            <h1>Weighbridge Log</h1>
            <p>Historical record of completed collections.</p>
        </div>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search transaction, truck or driver…">
            <select>
                <option>All dates</option>
                <option>Today</option>
                <option>This week</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Transaction</th>
                        <th>Date</th>
                        <th>Time</th>
                        <th>Order</th>
                        <th>Truck</th>
                        <th>Driver</th>
                        <th>Net</th>
                        <th>Operator</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>WB-2408</b></td>
                        <td>12 Aug 2026</td>
                        <td>06:54</td>
                        <td>PO-1042</td>
                        <td>GP 12 TY LF</td>
                        <td>Solomon Dube</td>
                        <td>28.60 t</td>
                        <td>Weighbridge Operator</td>
                    </tr>
                    <tr>
                        <td><b>WB-2407</b></td>
                        <td>12 Aug 2026</td>
                        <td>06:29</td>
                        <td>PO-1042</td>
                        <td>NW 44 XZ LP</td>
                        <td>Thabo Nkosi</td>
                        <td>29.30 t</td>
                        <td>Weighbridge Operator</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="field-note">
            Every transaction is stored with both weigh-in and weigh-out slips for audit.
            Net tonnage is calculated automatically and cannot be manually edited.
        </p>
    </article>
</section>
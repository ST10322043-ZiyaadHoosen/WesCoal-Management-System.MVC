@{
    ViewData["Title"] = "Truck Details";
    ViewData["RoleName"] = "Senior Manager";
    ViewData["RoleSubtitle"] = "Senior Management";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="truck-details">
    <a class="back-link" asp-controller="Management" asp-action="Fleet">← Fleet &amp; compliance</a>

    <div class="page-heading">
        <div>
            <p class="eyebrow">TRUCK RECORD</p>
            <h1>GP 12 TY LF</h1>
            <p>Eskom Arnot · Bulk Haul Logistics</p>
        </div>
        <span class="badge green">On weekly fleet list</span>
    </div>

    <div class="stat-grid">
        <article>
            <small>Registration</small>
            <strong>GP 12 TY LF</strong>
        </article>
        <article>
            <small>Trailer</small>
            <strong>GP 77 TL GP</strong>
        </article>
        <article>
            <small>Licence disc expiry</small>
            <strong>28 Feb 2027</strong>
        </article>
        <article>
            <small>Transporter</small>
            <strong>Bulk Haul Logistics</strong>
        </article>
    </div>

    <article class="panel">
        <div class="panel-title">
            <h2>Truck details</h2>
            <small class="field-note">Submitted by customer</small>
        </div>

        <dl>
            <dt>Customer</dt>
            <dd>Eskom Arnot</dd>

            <dt>Truck registration</dt>
            <dd>GP 12 TY LF</dd>

            <dt>Trailer registration</dt>
            <dd>GP 77 TL GP</dd>

            <dt>Transporter / Logistics company</dt>
            <dd>Bulk Haul Logistics</dd>

            <dt>Licence disc expiry</dt>
            <dd>28 Feb 2027</dd>
        </dl>
    </article>

    <article class="panel">
        <div class="panel-title">
            <h2>Licence disc / roadworthy document</h2>
            <small class="field-note">Customer-uploaded proof</small>
        </div>

        <div class="content-grid">
            <div class="panel" style="background:var(--bg); border-style:dashed;">
                <p class="muted" style="text-align:center; margin:2rem 0;">
                    📄 Licence disc preview<br>
                    <small>GP 12 TY LF — 28 Feb 2027</small>
                </p>
                <div class="form-actions" style="border-top:0; margin-top:0; padding-top:0;">
                    <a class="btn-outline" href="#" data-toast="Licence disc download simulated">Download document</a>
                </div>
            </div>

            <div class="panel">
                <h3>Document details</h3>
                <dl>
                    <dt>Document type</dt>
                    <dd>Vehicle licence disc</dd>

                    <dt>File name</dt>
                    <dd>GP12TYLF-licence-disc.pdf</dd>

                    <dt>Expiry date</dt>
                    <dd>28 Feb 2027</dd>
                </dl>
            </div>
        </div>

        <div class="info-box">
            This truck is on the customer’s weekly fleet list. Senior Management can view
            the submitted document but cannot edit or verify it.
        </div>
    </article>
</section>
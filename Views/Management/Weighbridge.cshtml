@{
    ViewData["Title"] = "Weighbridge Activity";
    ViewData["RoleName"] = "Senior Manager";
    ViewData["RoleSubtitle"] = "Senior Management";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="weighbridge">
    <div class="page-heading">
        <div>
            <p class="eyebrow">LIVE READ-ONLY VIEW</p>
            <h1>Weighbridge Activity</h1>
            <p>All truck collection transactions.</p>
        </div>
    </div>

    <div class="stat-grid">
        <article>
            <small>Today's loads</small>
            <strong>2</strong>
        </article>
        <article>
            <small>Net tonnage</small>
            <strong>57.9 t</strong>
        </article>
        <article>
            <small>Trucks on site</small>
            <strong>2</strong>
        </article>
        <article>
            <small>Average load</small>
            <strong>28.95 t</strong>
        </article>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search transaction, truck or driver…">
            <select>
                <option>All dates</option>
                <option>Today</option>
                <option>This week</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Transaction</th>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Truck</th>
                        <th>Driver</th>
                        <th>Net</th>
                        <th>Operator</th>
                        <th>Time</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr onclick="location.href='@Url.Action("TransactionDetails", "Management")'" style="cursor:pointer;">
                        <td><b>WB-2408</b></td>
                        <td>PO-1042</td>
                        <td>Eskom Arnot</td>
                        <td>GP 12 TY LF</td>
                        <td>Solomon Dube</td>
                        <td>28.60 t</td>
                        <td>Weighbridge Operator</td>
                        <td>06:54</td>
                        <td>›</td>
                    </tr>
                    <tr onclick="location.href='@Url.Action("TransactionDetails", "Management")'" style="cursor:pointer;">
                        <td><b>WB-2407</b></td>
                        <td>PO-1042</td>
                        <td>Eskom Arnot</td>
                        <td>NW 44 XZ LP</td>
                        <td>Thabo Nkosi</td>
                        <td>29.30 t</td>
                        <td>Weighbridge Operator</td>
                        <td>06:29</td>
                        <td>›</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="field-note">
            Senior Management sees all weighbridge activity. Click a transaction to view the slips
            and full collection details.
        </p>
    </article>
</section>
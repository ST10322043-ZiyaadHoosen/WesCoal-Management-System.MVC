@{
    ViewData["Title"] = "Reports &amp; Performance";
    ViewData["RoleName"] = "Senior Manager";
    ViewData["RoleSubtitle"] = "Senior Management";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="reports">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ANALYTICS</p>
            <h1>Reports &amp; Performance</h1>
            <p>Monthly operational and financial trends.</p>
        </div>
        <button class="btn-outline" data-toast="Report export simulated">Export report</button>
    </div>
    <div class="stat-grid">
        <article>
            <small>Revenue</small>
            <strong>R3.2m</strong>
            <span>+8% vs July</span>
        </article>
        <article>
            <small>Tonnage</small>
            <strong>1,840 t</strong>
            <span>+4% vs July</span>
        </article>
        <article>
            <small>Loads</small>
            <strong>64</strong>
            <span>28.8 t average</span>
        </article>
        <article>
            <small>Payment rate</small>
            <strong>81%</strong>
            <span>Within due date</span>
        </article>
    </div>
    <article class="panel">
        <h2>Monthly delivered tonnage</h2>
        <div class="bar-chart">
            <i style="height:48%">
                <span>Mar</span>
            </i>
            <i style="height:57%">
                <span>Apr</span>
            </i>
            <i style="height:64%">
                <span>May</span>
            </i>
            <i style="height:73%">
                <span>Jun</span>
            </i>
            <i style="height:82%">
                <span>Jul</span>
            </i>
            <i style="height:92%">
                <span>Aug</span>
            </i>
        </div>
    </article>
</section>


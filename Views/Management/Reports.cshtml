@{
    ViewData["Title"] = "Reports & Performance";
    ViewData["RoleName"] = "Senior Manager";
    ViewData["RoleSubtitle"] = "Senior Management";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="reports">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ANALYTICS & REPORTING</p>
            <h1>Reports & Performance</h1>
            <p>Company-wide operational and financial trends.</p>
        </div>
        <button class="btn-outline" data-toast="Report export simulated">Export report</button>
    </div>

    <div class="stat-grid">
        <article>
            <small>Total invoiced (YTD)</small>
            <strong>R1.29m</strong>
            <span>3 invoices</span>
        </article>
        <article>
            <small>Delivered tonnage (YTD)</small>
            <strong>1,020 t</strong>
            <span>Across active orders</span>
        </article>
        <article>
            <small>Outstanding</small>
            <strong class="highlight">R687,000</strong>
            <span>2 unpaid invoices</span>
        </article>
        <article>
            <small>Payment rate</small>
            <strong>46.6%</strong>
            <span>R600k collected</span>
        </article>
    </div>

    <article class="panel">
        <div class="panel-title">
            <h2>Report filters</h2>
            <small class="field-note">Filter the report output before downloading or exporting.</small>
        </div>

        <div class="toolbar">
            <select id="reportYear">
                <option value="2026" selected>2026</option>
                <option value="2025">2025</option>
            </select>

            <select id="reportMonth">
                <option value="all">All months</option>
                <option value="june">June 2026</option>
                <option value="july" selected>July 2026</option>
                <option value="aug">August 2026</option>
            </select>

            <select id="reportCustomer">
                <option value="all">All customers</option>
                <option value="eskom">Eskom Arnot</option>
                <option value="msobo">Msobo Coal</option>
                <option value="seriti">Seriti Resources</option>
            </select>

            <select id="reportType">
                <option value="all">All report types</option>
                <option value="revenue">Revenue summary</option>
                <option value="delivery">Delivery reconciliation</option>
                <option value="outstanding">Outstanding invoices</option>
                <option value="contract">Contract performance</option>
            </select>

            <button class="btn-gold" id="applyReportFilters">Apply filters</button>
        </div>
    </article>

    <div class="content-grid">
        <article class="panel report-card">
            <div class="panel-title">
                <h2>Monthly Revenue Summary</h2>
                <span class="badge green">Available</span>
            </div>
            <p class="muted">
                Revenue invoiced and collected per customer for the selected month.
            </p>
            <dl class="detail-grid">
                <div>
                    <dt>Filters applied</dt>
                    <dd class="filter-applied">July 2026 · All customers</dd>
                </div>
                <div>
                    <dt>Format</dt>
                    <dd>PDF / Excel</dd>
                </div>
            </dl>
            <div class="form-actions">
                <button class="btn-outline" data-toast="Revenue summary downloaded">Download PDF</button>
                <button class="btn-outline" data-toast="Revenue summary exported">Export Excel</button>
            </div>
        </article>

        <article class="panel report-card">
            <div class="panel-title">
                <h2>Delivery Reconciliation</h2>
                <span class="badge green">Available</span>
            </div>
            <p class="muted">
                Weighbridge deliveries matched to invoiced tonnage for audit proof.
            </p>
            <dl class="detail-grid">
                <div>
                    <dt>Filters applied</dt>
                    <dd class="filter-applied">July 2026 · All customers</dd>
                </div>
                <div>
                    <dt>Format</dt>
                    <dd>PDF / Excel</dd>
                </div>
            </dl>
            <div class="form-actions">
                <button class="btn-outline" data-toast="Delivery reconciliation downloaded">Download PDF</button>
                <button class="btn-outline" data-toast="Delivery reconciliation exported">Export Excel</button>
            </div>
        </article>

        <article class="panel report-card">
            <div class="panel-title">
                <h2>Outstanding Invoices</h2>
                <span class="badge amber">Action needed</span>
            </div>
            <p class="muted">
                Unpaid and overdue invoices for the selected customer and period.
            </p>
            <dl class="detail-grid">
                <div>
                    <dt>Filters applied</dt>
                    <dd class="filter-applied">July 2026 · All customers</dd>
                </div>
                <div>
                    <dt>Format</dt>
                    <dd>PDF / Excel</dd>
                </div>
            </dl>
            <div class="form-actions">
                <button class="btn-outline" data-toast="Outstanding invoices downloaded">Download PDF</button>
                <button class="btn-outline" data-toast="Outstanding invoices exported">Export Excel</button>
            </div>
        </article>

        <article class="panel report-card">
            <div class="panel-title">
                <h2>Contract Performance</h2>
                <span class="badge green">Available</span>
            </div>
            <p class="muted">
                Contract balances, delivery progress, and remaining tonnage per customer.
            </p>
            <dl class="detail-grid">
                <div>
                    <dt>Filters applied</dt>
                    <dd class="filter-applied">July 2026 · All customers</dd>
                </div>
                <div>
                    <dt>Format</dt>
                    <dd>PDF / Excel</dd>
                </div>
            </dl>
            <div class="form-actions">
                <button class="btn-outline" data-toast="Contract performance downloaded">Download PDF</button>
                <button class="btn-outline" data-toast="Contract performance exported">Export Excel</button>
            </div>
        </article>
    </div>

    <article class="panel">
        <div class="panel-title">
            <h2>Report preview</h2>
            <small class="field-note" id="previewLabel">Monthly revenue summary — July 2026 · All customers</small>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Contract</th>
                        <th>Month</th>
                        <th>Delivered</th>
                        <th>Price/t</th>
                        <th>Invoiced</th>
                        <th>Collected</th>
                        <th>Outstanding</th>
                    </tr>
                </thead>
                <tbody id="reportPreviewBody">
                    <tr>
                        <td>Eskom Arnot</td>
                        <td>CSA-2026-001</td>
                        <td>July 2026</td>
                        <td>340 t</td>
                        <td>R1,250</td>
                        <td>R425,000</td>
                        <td>R0</td>
                        <td>R425,000</td>
                    </tr>
                    <tr>
                        <td>Msobo Coal</td>
                        <td>ADH-2026-014</td>
                        <td>July 2026</td>
                        <td>200 t</td>
                        <td>R1,310</td>
                        <td>R262,000</td>
                        <td>R0</td>
                        <td>R262,000</td>
                    </tr>
                    <tr>
                        <td>Seriti Resources</td>
                        <td>SPOT-2026-009</td>
                        <td>July 2026</td>
                        <td>0 t</td>
                        <td>R1,400</td>
                        <td>R0</td>
                        <td>R0</td>
                        <td>R0</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <p class="field-note">
            Preview updates based on the selected year, month, customer, and report type.
            Downloaded PDF/Excel exports include the same filtered data plus audit references.
        </p>
    </article>

    <div class="content-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Revenue by customer</h2>
                <small class="field-note">Total invoiced value per customer (YTD)</small>
            </div>
            <canvas id="revenueByCustomer" height="220"></canvas>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>Monthly deliveries vs target</h2>
                <small class="field-note">Actual tonnage delivered vs contract pace</small>
            </div>
            <canvas id="monthlyDeliveries" height="220"></canvas>
        </article>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
    <script>
        (function () {
        // Revenue by customer
        new Chart(document.getElementById('revenueByCustomer'), {
        type: 'bar',
        data: {
        labels: ['Eskom Arnot', 'Msobo Coal', 'Seriti Resources'],
        datasets: [{
        label: 'Invoiced (R)',
        data: [1025, 262, 0],
        backgroundColor: ['#c8102e', '#1f3a5f', '#18794e'],
        borderRadius: 10
        }]
        },
        options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: {
        y: {
        beginAtZero: true,
        ticks: {
        callback: function (value) {
        return 'R' + value + 'k';
        }
        }
        }
        }
        }
        });

        // Monthly deliveries vs target
        new Chart(document.getElementById('monthlyDeliveries'), {
        type: 'bar',
        data: {
        labels: ['May', 'June', 'July', 'Aug'],
        datasets: [
        {
        label: 'Delivered (t)',
        data: [420, 480, 340, 340],
        backgroundColor: '#1769aa',
        borderRadius: 6
        },
        {
        label: 'Contracted target (t)',
        data: [417, 417, 417, 417],
        type: 'line',
        borderColor: '#c8102e',
        borderDash: [5, 5],
        fill: false,
        pointBackgroundColor: '#c8102e'
        }
        ]
        },
        options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } },
        scales: { y: { beginAtZero: true, title: { display: true, text: 'Tonnes' } } }
        }
        });

        document.getElementById('applyReportFilters').addEventListener('click', function () {
        const year = document.getElementById('reportYear').value;
        const month = document.getElementById('reportMonth').options[document.getElementById('reportMonth').selectedIndex].text;
        const customer = document.getElementById('reportCustomer').options[document.getElementById('reportCustomer').selectedIndex].text;
        const type = document.getElementById('reportType').options[document.getElementById('reportType').selectedIndex].text;

        const label = document.getElementById('previewLabel');
        if (label) {
        label.textContent = `Report preview — ${month} · ${customer} · ${type}`;
        }

        document.querySelectorAll('.filter-applied').forEach(el => {
        el.textContent = `${month} · ${customer} · ${type}`;
        });

        const toast = document.querySelector('[data-toast-box]');
        if (toast) {
        toast.textContent = `Filters applied: ${year}, ${month}, ${customer}, ${type}`;
        toast.classList.add('show');
        setTimeout(() => toast.classList.remove('show'), 2500);
        }
        });
        })();
    </script>
}
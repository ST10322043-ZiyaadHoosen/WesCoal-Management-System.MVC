@{
    ViewData["Title"] = "Senior Management";
    ViewData["RoleName"] = "Senior Manager";
    ViewData["RoleSubtitle"] = "Senior Management";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="dashboard">
    <div class="page-heading">
        <div>
            <p class="eyebrow">EXECUTIVE OVERVIEW</p>
            <h1>Senior Management</h1>
            <p>Full operational and financial visibility.</p>
        </div>
        <span class="badge blue">Read only</span>
    </div>

    <div class="stat-grid">
        <article>
            <small>Active contracts</small>
            <strong>4</strong>
            <span>R9.78m active value</span>
        </article>
        <article>
            <small>Open orders</small>
            <strong>4</strong>
            <span>1,450 t ordered</span>
        </article>
        <article>
            <small>Outstanding invoices</small>
            <strong class="highlight">R687,000</strong>
            <span>2 unpaid invoices</span>
        </article>
        <article>
            <small>Today's loads</small>
            <strong>2</strong>
            <span>57.9 t collected</span>
        </article>
    </div>

    <div class="content-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Operational performance</h2>
                <a class="btn-outline" asp-controller="Management" asp-action="Reports">View reports</a>
            </div>

            <div class="metric-bars">
                <label>
                    Order fulfilment
                    <span>23%</span>
                    <div class="progress"><i style="width:23%"></i></div>
                </label>
                <label>
                    Invoice collection rate
                    <span>47%</span>
                    <div class="progress"><i style="width:47%"></i></div>
                </label>
                <label>
                    SAP activation progress
                    <span>50%</span>
                    <div class="progress"><i style="width:50%"></i></div>
                </label>
            </div>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>Items requiring attention</h2>
                <a class="btn-outline" asp-controller="Management" asp-action="Audit">View audit</a>
            </div>

            <div class="check-list">
                <span class="warn">2 orders awaiting SAP activation</span>
                <span class="warn">1 customer account on hold</span>
                <span class="warn">0 weighbridge transactions flagged for review</span>
            </div>
        </article>
    </div>

    <div class="content-grid">
        <article class="panel">
            <div class="panel-title">
                <h2>Recent weighbridge activity</h2>
                <a class="btn-outline" asp-controller="Management" asp-action="Weighbridge">View all</a>
            </div>

            <div class="mini-table">
                <a asp-controller="Management" asp-action="TransactionDetails">
                    <b>WB-2408</b>
                    <span>GP 12 TY LF · Solomon Dube · 28.60 t</span>
                    <em class="badge green">Complete</em>
                </a>
                <a asp-controller="Management" asp-action="TransactionDetails">
                    <b>WB-2407</b>
                    <span>NW 44 XZ LP · Thabo Nkosi · 29.30 t</span>
                    <em class="badge green">Complete</em>
                </a>
            </div>
        </article>

        <article class="panel">
            <div class="panel-title">
                <h2>Recent audit activity</h2>
                <a class="btn-outline" asp-controller="Management" asp-action="Audit">View audit log</a>
            </div>

            <div class="check-list">
                <span class="ok">✓ Finance attached SAP number · PO-1042</span>
                <span class="ok">✓ Weighbridge Operator logged WB-2408</span>
                <span class="ok">✓ Sales Manager created PO-1048</span>
            </div>
        </article>
    </div>
</section>
@{
    ViewData["Title"] = "Audit Log";
    ViewData["RoleName"] = "Senior Manager";
    ViewData["RoleSubtitle"] = "Senior Management";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="audit">
    <div class="page-heading">
        <div>
            <p class="eyebrow">IMMUTABLE HISTORY</p>
            <h1>Audit Log</h1>
            <p>Who performed each important system action, and when.</p>
        </div>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search user, action or record…">
            <select>
                <option>All roles</option>
                <option>Sales</option>
                <option>Finance</option>
                <option>Logistics</option>
                <option>Customer</option>
                <option>Management</option>
            </select>
            <select>
                <option>All actions</option>
                <option>Created contract</option>
                <option>Created purchase order</option>
                <option>Attached SAP number</option>
                <option>Weigh-in recorded</option>
                <option>Weigh-out completed</option>
                <option>Generated invoice</option>
                <option>Marked invoice paid</option>
                <option>Uploaded weekly fleet</option>
                <option>Created user</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Affected record</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>

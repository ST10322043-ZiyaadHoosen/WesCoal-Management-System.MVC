                        <td>Weighbridge Operator</td>
                        <td>Logistics</td>
                        <td>Recorded weigh-in</td>
                        <td>WB-2409 · PO-1042</td>
                    </tr>
                    <tr>
                        <td>12 Aug 2026 · 08:47</td>
                        <td>Finance Officer</td>
                        <td>Finance</td>
                        <td>Marked invoice paid</td>
                        <td>INV-2026-071</td>
                    </tr>
                    <tr>
                        <td>11 Aug 2026 · 16:20</td>
                        <td>Finance Officer</td>
                        <td>Finance</td>

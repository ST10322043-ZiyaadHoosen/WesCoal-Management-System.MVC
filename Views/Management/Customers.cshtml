@{
    ViewData["Title"] = "All Customers";
    ViewData["RoleName"] = "Senior Manager";
    ViewData["RoleSubtitle"] = "Senior Management";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="customers">
    <div class="page-heading">
        <div>
            <p class="eyebrow">COMPANY-WIDE VIEW</p>
            <h1>All Customers</h1>
            <p>Customer accounts, contacts and current account standing.</p>
        </div>
        <span class="badge blue">Read only</span>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search customer, site or contact…">
            <select>
                <option>All account statuses</option>
                <option>Active</option>
                <option>On hold</option>
            </select>
        </div>
    </article>

    <div class="contract-list">
        <a class="contract-card" asp-controller="Management" asp-action="CustomerDetails">
            <div class="cc-head">
                <div class="cc-id">
                    <b>Eskom Arnot</b>
                    <span class="badge green">Active</span>
                </div>
                <span class="badge green">1 active contract</span>
            </div>
            <p class="cc-customer">Arnot Power Station · Mpumalanga</p>

            <div class="cc-meta">
                <div>
                    <small>Contact person</small>
                    <b>Thabo Mokoena</b>
                </div>
                <div>
                    <small>Email</small>
                    <b>thabo.mokoena@eskom.co.za</b>
                </div>
                <div>
                    <small>Phone</small>
                    <b>+27 13 297 1000</b>
                </div>
                <div>
                    <small>Account status</small>
                    <b class="pos">Active</b>
                </div>
            </div>
        </a>

        <a class="contract-card" asp-controller="Management" asp-action="CustomerDetails">
            <div class="cc-head">
                <div class="cc-id">
                    <b>Msobo Coal</b>
                    <span class="badge amber">On hold</span>
                </div>
                <span class="badge amber">On hold</span>
            </div>
            <p class="cc-customer">Ermelo · Mpumalanga</p>

            <div class="cc-meta">
                <div>
                    <small>Contact person</small>
                    <b>Naledi Maseko</b>
                </div>
                <div>
                    <small>Email</small>
                    <b>naledi.maseko@msobo.co.za</b>
                </div>
                <div>
                    <small>Phone</small>
                    <b>+27 17 819 1122</b>
                </div>
                <div>
                    <small>Account status</small>
                    <b class="neg">On hold</b>
                </div>
            </div>
        </a>

        <a class="contract-card" asp-controller="Management" asp-action="CustomerDetails">
            <div class="cc-head">
                <div class="cc-id">
                    <b>Seriti Resources</b>
                    <span class="badge green">Active</span>
                </div>
                <span class="badge green">2 active contracts</span>
            </div>
            <p class="cc-customer">Kriel · Mpumalanga</p>

            <div class="cc-meta">
                <div>
                    <small>Contact person</small>
                    <b>Lerato Nkosi</b>
                </div>
                <div>
                    <small>Email</small>
                    <b>lerato.nkosi@seriti.co.za</b>
                </div>
                <div>
                    <small>Phone</small>
                    <b>+27 17 648 2000</b>
                </div>
                <div>
                    <small>Account status</small>
                    <b class="pos">Active</b>
                </div>
            </div>
        </a>
    </div>

    <p class="field-note">
        Senior Management sees all customer accounts and statuses. This view is read-only.
    </p>
</section>
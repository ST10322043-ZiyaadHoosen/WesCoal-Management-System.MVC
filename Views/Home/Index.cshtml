@{
    ViewData["Title"] = "Sign In";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Wescoal · Weighbridge & Invoicing System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            /* Improve left brand panel */
            .login-intro {
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 3rem;
                position: relative;
            }

            .login-brand {
                flex-direction: column;
                align-items: center;
                gap: .5rem;
            }

                .login-brand .brand-mark {
                    width: 72px;
                    height: 72px;
                    font-size: 2rem;
                    border-radius: 20px;
                }

                .login-brand strong {
                    font-size: 2.4rem;
                    letter-spacing: -.03em;
                }

                .login-brand small {
                    font-size: .95rem;
                }

            .prototype-note {
                position: absolute;
                bottom: 2rem;
                left: 0;
                right: 0;
                text-align: center;
                color: #ffffff4d;
            }
    </style>
</head>
<body>
    <div class="login-page">

        <!-- LEFT: company brand only -->
        <section class="login-intro">
            <div class="login-brand">
                <span class="brand-mark">W</span>
                <div>
                    <strong>Wescoal</strong>
                    <small>Weighbridge &amp; Invoicing System</small>
                </div>
            </div>

            <small class="prototype-note">© 2026 Wescoal (Pty) Ltd · Prototype — all data simulated</small>
        </section>

        <!-- RIGHT: portal selector + sign in -->
        <section class="login-form-panel">
            <form class="role-login-form" data-login-form>
                <h2>Sign in</h2>
                <p>Select a portal to explore the prototype.</p>

                <fieldset class="role-selector">
                    <legend>Select portal</legend>
                    <div class="role-grid">
                        <label class="role-option selected">
                            <input type="radio" name="role" value="/Sales" data-user="sales.manager" checked />
                            <span class="role-tag">Sales</span><strong>Sales Manager</strong>
                        </label>
                        <label class="role-option">
                            <input type="radio" name="role" value="/Finance" data-user="finance.officer" />
                            <span class="role-tag">Finance</span><strong>Finance Officer</strong>
                        </label>
                        <label class="role-option">
                            <input type="radio" name="role" value="/Logistics" data-user="weighbridge.operator" />
                            <span class="role-tag">Weighbridge</span><strong>Operator</strong>
                        </label>
                        <label class="role-option">
                            <input type="radio" name="role" value="/Management" data-user="senior.manager" />
                            <span class="role-tag">Management</span><strong>Senior Manager</strong>
                        </label>
                        <label class="role-option">
                            <input type="radio" name="role" value="/SiteManager" data-user="site.manager" />
                            <span class="role-tag">Site</span><strong>Site Manager</strong>
                        </label>
                        <label class="role-option">
                            <input type="radio" name="role" value="/Customer" data-user="customer.user" />
                            <span class="role-tag">Customer</span><strong>Customer</strong>
                        </label>
                    </div>
                </fieldset>

                <label class="login-field">
                    Username
                    <input type="text" id="loginUser" value="sales.manager" required />
                </label>
                <label class="login-field">
                    Password
                    <input type="password" value="prototype" required />
                </label>

                <button class="btn-gold login-button" type="submit">Sign in</button>
                <small class="form-note">Invite-only system · All demonstration data is simulated</small>
            </form>
        </section>
    </div>

    <script>
            (function () {
                const opts = document.querySelectorAll('.role-option');
                const user = document.getElementById('loginUser');

                opts.forEach(function (o) {
                    o.addEventListener('click', function () {
                        opts.forEach(x => x.classList.remove('selected'));
                        o.classList.add('selected');
                        const input = o.querySelector('input');
                        if (user && input.dataset.user) user.value = input.dataset.user;
                    });
                });

                document.querySelector('[data-login-form]').addEventListener('submit', function (e) {
                    e.preventDefault();
                    const sel = document.querySelector('.role-option.selected input');
                    window.location.href = sel.value;
                });
            })();
    </script>
</body>
</html>
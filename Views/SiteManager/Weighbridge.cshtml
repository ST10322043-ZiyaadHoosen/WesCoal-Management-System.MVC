@{
    ViewData["Title"] = "Weighbridge Activity";
    ViewData["RoleName"] = "Site Manager";
    ViewData["RoleSubtitle"] = "Operations Oversight";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="weighbridge">
    <div class="page-heading">
        <div>
            <p class="eyebrow">OPERATIONAL LOG</p>
            <h1>Weighbridge Activity</h1>
            <p>Full collection log for site oversight.</p>
        </div>
    </div>

    <div class="stat-grid">
        <article>
            <small>Today's loads</small>
            <strong>2</strong>
        </article>
        <article>
            <small>Net tonnage</small>
            <strong>57.9 t</strong>
        </article>
        <article>
            <small>Trucks on site</small>
            <strong>2</strong>
        </article>
        <article>
            <small>Average turnaround</small>
            <strong>42 min</strong>
        </article>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search transaction, truck or driver…">
            <select>
                <option>All dates</option>
                <option>Today</option>
                <option>This week</option>
            </select>
            <select>
                <option>All operators</option>
                <option>J. van der Merwe</option>
                <option>P. Ndlovu</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Transaction</th>
                        <th>Order</th>
                        <th>Truck</th>
                        <th>Driver</th>
                        <th>In</th>
                        <th>Out</th>
                        <th>Net</th>
                        <th>Operator</th>
                    </tr>
                </thead>
                <tbody>
                    <tr onclick="location.href='@Url.Action("TransactionDetails", "SiteManager")'" style="cursor:pointer;">
                        <td><b>WB-2408</b></td>
                        <td>PO-1042</td>
                        <td>GP 12 TY LF</td>
                        <td>Solomon Dube</td>
                        <td>22.40 t</td>
                        <td>51.00 t</td>
                        <td>28.60 t</td>
                        <td>J. van der Merwe</td>
                    </tr>
                    <tr onclick="location.href='@Url.Action("TransactionDetails", "SiteManager")'" style="cursor:pointer;">
                        <td><b>WB-2407</b></td>
                        <td>PO-1042</td>
                        <td>NW 44 XZ LP</td>
                        <td>Thabo Nkosi</td>
                        <td>23.00 t</td>
                        <td>52.30 t</td>
                        <td>29.30 t</td>
                        <td>P. Ndlovu</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </article>
</section>
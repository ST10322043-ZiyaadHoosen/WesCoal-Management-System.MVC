@{
    ViewData["Title"] = "Site Audit";
    ViewData["RoleName"] = "Site Manager";
    ViewData["RoleSubtitle"] = "Operations Oversight";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="audit">
    <div class="page-heading">
        <div>
            <p class="eyebrow">OPERATIONAL AUDIT</p>
            <h1>Site Audit</h1>
            <p>Who did what, and when, across site operations.</p>
        </div>
    </div>

    <article class="panel">
        <div class="toolbar">
            <input type="search" placeholder="Search user, action or reference…">
            <select>
                <option>All action types</option>
                <option>Weigh-in</option>
                <option>Weigh-out</option>
                <option>Order created</option>
                <option>SAP attached</option>
            </select>
        </div>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>User</th>
                        <th>Role</th>
                        <th>Action</th>
                        <th>Reference</th>
                    </tr>
                </thead>

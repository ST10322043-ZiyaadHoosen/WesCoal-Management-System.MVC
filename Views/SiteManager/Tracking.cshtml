@{
    ViewData["Title"] = "Order Tracking";
    ViewData["RoleName"] = "Site Manager";
    ViewData["RoleSubtitle"] = "Operations Oversight";
    ViewData["Initials"] = "SM";
    Layout = "_PortalLayout";
}

<section class="portal-screen active" data-screen="tracking">
    <div class="page-heading">
        <div>
            <p class="eyebrow">ORDER LIFECYCLE</p>
            <h1>Order Tracking</h1>
            <p>Created by, SAP status and responsible operator.</p>
        </div>
    </div>

    <article class="panel">
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Order</th>
                        <th>Customer</th>
                        <th>Created by</th>
                        <th>SAP</th>
                        <th>Operator</th>
                        <th>Progress</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <tr onclick="location.href='@Url.Action("TrackingDetails", "SiteManager")'" style="cursor:pointer;">
                        <td><b>PO-1042</b></td>
                        <td>Eskom Arnot</td>
                        <td>Sales Manager</td>
                        <td>45001234</td>
                        <td>J. van der Merwe</td>
                        <td>340 / 500 t</td>
                        <td><span class="badge blue">In progress</span></td>
                    </tr>
                    <tr onclick="location.href='@Url.Action("TrackingDetails", "SiteManager")'" style="cursor:pointer;">
                        <td><b>PO-1045</b></td>
                        <td>Seriti Resources</td>
                        <td>Sales Manager</td>
                        <td>45001229</td>
                        <td>—</td>
                        <td>0 / 400 t</td>
                        <td><span class="badge green">Ready</span></td>
                    </tr>
                    <tr>
                        <td><b>PO-1048</b></td>
                        <td>Msobo Coal</td>
                        <td>Sales Manager</td>
                        <td>—</td>
                        <td>—</td>
                        <td>0 / 300 t</td>
                        <td><span class="badge amber">Awaiting SAP</span></td>
                    </tr>
                    <tr>
                        <td><b>PO-1051</b></td>
                        <td>Seriti Resources</td>
                        <td>Sales Manager</td>
                        <td>—</td>
                        <td>—</td>
                        <td>0 / 250 t</td>
                        <td><span class="badge amber">Awaiting SAP</span></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <p class="field-note">
            Every order shows its full accountability chain — who created it (Sales), who attached the
            SAP number (Finance), and which operator is responsible for its collections (Logistics).
            No financial values are shown to the Site Manager.
        </p>
    </article>
</section>